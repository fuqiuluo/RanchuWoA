--- a/hw/android/ranchu-vsock.c
+++ b/hw/android/ranchu-vsock.c
@@ -0,0 +1,1491 @@
+/*
+ * RanchuWoA: 纯用户态 virtio-vsock 设备（ranchu-vsock-device）。
+ *
+ * Android 15 模拟器镜像把非图形 qemud 服务（sensors 等）从 goldfish pipe 搬到了 virtio-vsock：
+ * guest 连宿主（CID 2）端口 5000，先写 "pipe:qemud:<服务>\0"，之后按 qemud 帧格式收发；
+ * adbd 也同时监听 vsock:5555。Windows 宿主没有 vhost-vsock，这里在 QEMU 进程里直接实现
+ * virtio-vsock 的设备端（规范 5.10，只做 STREAM）：
+ *   - guest -> 宿主 5000：内置服务 qemud:sensors、qemud:boot-properties、QemuMiscPipe、
+ *     clipboard（与 Windows 剪贴板双向同步）、qemud:camera（空摄像头列表）、qemud:gps（固定位置）；
+ *     其余服务名（如 qemud:fingerprintlisten）保持连接、丢弃数据——不能 RST：goldfish HAL
+ *     普遍把对端关闭当成可读的 EOF，在 read/epoll 循环里 100% 空转；
+ *   - 宿主 TCP 转发：forward=<宿主端口>:<guest 端口>[;...]，本机连上宿主端口后
+ *     由设备向 guest 发起 vsock 连接（adb connect 127.0.0.1:<宿主端口> 直连 guest adbd）；
+ *   - 正常关机：guest 开机完成后（poweroff-ready），system_powerdown（QMP/HMP、SDL 关窗）由设备
+ *     自己当 adb 客户端连 guest adbd 执行 svc power shutdown，取代板子的电源键（Android 只把它当锁屏）；
+ *   - 开机命令：boot-cmd=<shell 命令>，每次开机完成后同样经 adbd 执行（adbd 没起来时重试几次）。
+ * 其余目标端口一律 RST（guest 的 vsock ping 端口 5001 本来就期望失败）。
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include <math.h>
+#include "qapi/error.h"
+#include "qemu/error-report.h"
+#include "qemu/iov.h"
+#include "qemu/main-loop.h"
+#include "qemu/module.h"
+#include "qemu/sockets.h"
+#include "qemu/queue.h"
+#include "qemu/timer.h"
+#include "system/runstate.h"
+#include "hw/virtio/virtio.h"
+#include "hw/core/qdev-properties.h"
+#include "standard-headers/linux/virtio_ids.h"
+#include "standard-headers/linux/virtio_vsock.h"
+#include "qom/object.h"
+#include "ranchu-sensors.h"
+
+#define TYPE_RANCHU_VSOCK "ranchu-vsock-device"
+OBJECT_DECLARE_SIMPLE_TYPE(RanchuVsock, RANCHU_VSOCK)
+
+#define RV_HOST_CID         2
+#define RV_PIPE_PORT        5000        /* qemu pipe over vsock 的服务端口 */
+#define RV_ADBD_PORT        5555        /* guest adbd 监听的 vsock 端口 */
+#define RV_MAX_PAYLOAD      4000        /* guest rx 缓冲 4096 字节（含 44 字节头） */
+#define RV_BUF_ALLOC        (256 * 1024)
+#define RV_QUEUE_SIZE       128
+
+typedef struct RvConn RvConn;
+
+typedef enum {
+    RV_CONNECTING,      /* 宿主发起，等 guest RESPONSE */
+    RV_CONNECTED,
+    RV_CLOSING,         /* 已发 SHUTDOWN，等 guest RST */
+} RvState;
+
+struct RvConn {
+    RanchuVsock *dev;
+    uint32_t local_port;        /* 宿主侧端口 */
+    uint32_t peer_port;         /* guest 侧端口 */
+    RvState state;
+    /* 流控（规范 5.10.6.3）：guest 通告的缓冲与已消费量；本侧已发/已消费量 */
+    uint32_t peer_buf_alloc;
+    uint32_t peer_fwd_cnt;
+    uint32_t tx_cnt;
+    uint32_t fwd_cnt;
+    uint32_t credit_sent_fwd;
+    /* 转发连接：宿主 socket */
+    int sock;
+    GByteArray *sock_out;       /* guest -> socket 待写 */
+    bool sock_reading;
+    /* 内置服务：先收服务名（以 NUL 结尾） */
+    char name[160];
+    size_t name_len;
+    bool name_done;
+    const struct RvService *svc;
+    void *svc_priv;
+    GByteArray *in;             /* 服务的输入重组缓冲 */
+    QEMUTimer *connect_timer;   /* 宿主发起的连接：guest 迟迟不回 RESPONSE 就放弃 */
+    QTAILQ_ENTRY(RvConn) next;
+};
+
+typedef struct RvService {
+    const char *name;           /* 完整服务名（guest 写入的 "pipe:..."） */
+    void (*open)(RvConn *c);
+    void (*recv)(RvConn *c, const uint8_t *data, size_t len);
+    void (*close)(RvConn *c);
+} RvService;
+
+typedef struct RvPkt {
+    struct virtio_vsock_hdr hdr;
+    uint8_t *data;
+    QSIMPLEQ_ENTRY(RvPkt) next;
+} RvPkt;
+
+typedef struct RvForward {
+    RanchuVsock *dev;
+    int listen_fd;
+    uint32_t host_port;
+    uint32_t guest_port;
+} RvForward;
+
+struct RanchuVsock {
+    VirtIODevice parent_obj;
+    VirtQueue *rx_vq;
+    VirtQueue *tx_vq;
+    VirtQueue *evt_vq;
+    uint64_t guest_cid;
+    char *forward;
+    QTAILQ_HEAD(, RvConn) conns;
+    QSIMPLEQ_HEAD(, RvPkt) rxq;
+    GPtrArray *forwards;
+    uint32_t next_local_port;
+    char *boot_props;           /* "键=值;键=值"，经 qemud:boot-properties 交给 qemu-props */
+    RvConn *clip_conn;          /* 当前的 clipboard 连接 */
+    struct RvClipboard *clip;   /* 宿主剪贴板桥（仅 Windows） */
+    bool debug;                 /* debug=on 时把连接状态变化打到 stderr */
+    QEMUTimer *adb_reg_timer;   /* bootcomplete 后延迟登记 adb，避开 adbd 重启 */
+    double gps_lat, gps_lon, gps_alt;   /* qemud:gps 报给 guest 的固定位置（gps 属性） */
+    bool boot_completed;        /* 收到过 QemuMiscPipe 的 bootcomplete（guest 重启时清零） */
+    Notifier powerdown;         /* system_powerdown / 关窗 → 经 adbd 请求 guest 正常关机 */
+    char *boot_cmd;             /* 每次开机完成后经 adbd 执行的 shell 命令（boot-cmd 属性） */
+    QEMUTimer *boot_cmd_timer;
+    int boot_cmd_tries;
+};
+
+#define RV_DBG(s, fmt, ...) do { \
+        if ((s)->debug) { \
+            info_report("ranchu-vsock: " fmt, ##__VA_ARGS__); \
+        } \
+    } while (0)
+
+static void rv_flush_rx(RanchuVsock *s);
+static void rv_conn_free(RvConn *c);
+static void rv_sock_readable(void *opaque);
+static void rv_sock_writable(void *opaque);
+
+/* ------------------------------------------------------------------ */
+/* 发往 guest 的包                                                      */
+/* ------------------------------------------------------------------ */
+
+static void rv_queue_raw(RanchuVsock *s, uint32_t src_port, uint32_t dst_port,
+                         uint16_t op, uint32_t flags, uint32_t fwd_cnt,
+                         const uint8_t *data, uint32_t len)
+{
+    RvPkt *p = g_new0(RvPkt, 1);
+    p->hdr.src_cid = cpu_to_le64(RV_HOST_CID);
+    p->hdr.dst_cid = cpu_to_le64(s->guest_cid);
+    p->hdr.src_port = cpu_to_le32(src_port);
+    p->hdr.dst_port = cpu_to_le32(dst_port);
+    p->hdr.len = cpu_to_le32(len);
+    p->hdr.type = cpu_to_le16(VIRTIO_VSOCK_TYPE_STREAM);
+    p->hdr.op = cpu_to_le16(op);
+    p->hdr.flags = cpu_to_le32(flags);
+    p->hdr.buf_alloc = cpu_to_le32(RV_BUF_ALLOC);
+    p->hdr.fwd_cnt = cpu_to_le32(fwd_cnt);
+    if (len) {
+        p->data = g_memdup2(data, len);
+    }
+    QSIMPLEQ_INSERT_TAIL(&s->rxq, p, next);
+}
+
+static void rv_send(RvConn *c, uint16_t op, uint32_t flags)
+{
+    rv_queue_raw(c->dev, c->local_port, c->peer_port, op, flags, c->fwd_cnt, NULL, 0);
+    c->credit_sent_fwd = c->fwd_cnt;
+    rv_flush_rx(c->dev);
+}
+
+/* 内置服务 / socket 向 guest 发数据（按包切分，计入 tx_cnt） */
+static void rv_send_data(RvConn *c, const uint8_t *data, size_t len)
+{
+    while (len > 0) {
+        uint32_t n = MIN(len, RV_MAX_PAYLOAD);
+        rv_queue_raw(c->dev, c->local_port, c->peer_port, VIRTIO_VSOCK_OP_RW, 0,
+                     c->fwd_cnt, data, n);
+        c->tx_cnt += n;
+        c->credit_sent_fwd = c->fwd_cnt;
+        data += n;
+        len -= n;
+    }
+    rv_flush_rx(c->dev);
+}
+
+static uint32_t rv_peer_credit(RvConn *c)
+{
+    uint32_t in_flight = c->tx_cnt - c->peer_fwd_cnt;
+    return c->peer_buf_alloc > in_flight ? c->peer_buf_alloc - in_flight : 0;
+}
+
+static void rv_flush_rx(RanchuVsock *s)
+{
+    VirtIODevice *vdev = VIRTIO_DEVICE(s);
+    bool pushed = false;
+
+    if (!(vdev->status & VIRTIO_CONFIG_S_DRIVER_OK)) {
+        return;
+    }
+    while (!QSIMPLEQ_EMPTY(&s->rxq)) {
+        RvPkt *p = QSIMPLEQ_FIRST(&s->rxq);
+        uint32_t len = le32_to_cpu(p->hdr.len);
+        VirtQueueElement *elem = virtqueue_pop(s->rx_vq, sizeof(VirtQueueElement));
+        if (!elem) {
+            break;          /* guest 还没补 rx 缓冲；等 rx 队列的 kick */
+        }
+        size_t room = iov_size(elem->in_sg, elem->in_num);
+        if (room < sizeof(p->hdr) + len) {
+            error_report("ranchu-vsock: guest rx 缓冲太小 (%zu < %zu)，丢包",
+                         room, sizeof(p->hdr) + len);
+            virtqueue_push(s->rx_vq, elem, 0);
+        } else {
+            iov_from_buf(elem->in_sg, elem->in_num, 0, &p->hdr, sizeof(p->hdr));
+            if (len) {
+                iov_from_buf(elem->in_sg, elem->in_num, sizeof(p->hdr), p->data, len);
+            }
+            virtqueue_push(s->rx_vq, elem, sizeof(p->hdr) + len);
+        }
+        g_free(elem);
+        QSIMPLEQ_REMOVE_HEAD(&s->rxq, next);
+        g_free(p->data);
+        g_free(p);
+        pushed = true;
+    }
+    if (pushed) {
+        virtio_notify(vdev, s->rx_vq);
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* 连接管理                                                            */
+/* ------------------------------------------------------------------ */
+
+static RvConn *rv_find(RanchuVsock *s, uint32_t local_port, uint32_t peer_port)
+{
+    RvConn *c;
+    QTAILQ_FOREACH(c, &s->conns, next) {
+        if (c->local_port == local_port && c->peer_port == peer_port) {
+            return c;
+        }
+    }
+    return NULL;
+}
+
+static RvConn *rv_conn_new(RanchuVsock *s, uint32_t local_port, uint32_t peer_port)
+{
+    RvConn *c = g_new0(RvConn, 1);
+    c->dev = s;
+    c->local_port = local_port;
+    c->peer_port = peer_port;
+    c->sock = -1;
+    QTAILQ_INSERT_TAIL(&s->conns, c, next);
+    return c;
+}
+
+/*
+ * 关宿主 socket。两个坑（以前都踩了：guest 重启后 adb server 收不到断开、不再重连，adb 卡死）：
+ *  - Windows 上 QEMU 的 socket()/accept() 返回包装过的 CRT fd，只能用 close()（qemu_close_wrap）关，
+ *    closesocket() 把它当 SOCKET 句柄、静默失败；
+ *  - 即便 close() 成功，accept 出来的 socket 实测仍停在 CLOSE_WAIT/ESTABLISHED、不发 FIN（底层对象
+ *    还有别的引用），对端永远等不到断开。先 shutdown(SD_BOTH) 在协议层立即发 FIN。
+ */
+static void rv_close_sock(int fd)
+{
+    qemu_set_fd_handler(fd, NULL, NULL, NULL);
+    shutdown(fd, 2);                    /* SHUT_RDWR / SD_BOTH */
+    close(fd);
+}
+
+static void rv_conn_free(RvConn *c)
+{
+    QTAILQ_REMOVE(&c->dev->conns, c, next);
+    if (c->connect_timer) {
+        timer_free(c->connect_timer);       /* 可能正在它自己的回调里：timer_free 允许 */
+    }
+    if (c->sock >= 0) {
+        rv_close_sock(c->sock);
+    }
+    if (c->sock_out) {
+        g_byte_array_free(c->sock_out, true);
+    }
+    if (c->svc && c->svc->close) {
+        c->svc->close(c);
+    }
+    if (c->in) {
+        g_byte_array_free(c->in, true);
+    }
+    g_free(c);
+}
+
+/*
+ * 宿主发起连接：发 REQUEST 并计时。guest 正在关机/重启、或 vsock 驱动刚起来时，REQUEST 可能没人回，
+ * 连接会一直挂在 CONNECTING、宿主 socket 也一直开着（对方以为连上了）。超时后 RST 并关掉宿主
+ * socket，让对方（adb server 等）重连。
+ */
+#define RV_CONNECT_TIMEOUT_MS 5000
+
+static void rv_connect_timeout(void *opaque)
+{
+    RvConn *c = opaque;
+
+    if (c->state == RV_CONNECTING) {
+        RV_DBG(c->dev, "guest 没回应连接请求（本端 %u -> guest %u），放弃", c->local_port,
+               c->peer_port);
+        rv_send(c, VIRTIO_VSOCK_OP_RST, 0);
+        rv_conn_free(c);
+    }
+}
+
+static void rv_conn_connect(RvConn *c)
+{
+    c->state = RV_CONNECTING;
+    c->connect_timer = timer_new_ms(QEMU_CLOCK_REALTIME, rv_connect_timeout, c);
+    timer_mod(c->connect_timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + RV_CONNECT_TIMEOUT_MS);
+    rv_send(c, VIRTIO_VSOCK_OP_REQUEST, 0);
+}
+
+/* 宿主侧主动关闭：发 SHUTDOWN，等 guest 回 RST 再释放 */
+static void rv_conn_shutdown(RvConn *c)
+{
+    if (c->sock >= 0) {
+        rv_close_sock(c->sock);
+        c->sock = -1;
+    }
+    if (c->state == RV_CONNECTED) {
+        c->state = RV_CLOSING;
+        rv_send(c, VIRTIO_VSOCK_OP_SHUTDOWN,
+                VIRTIO_VSOCK_SHUTDOWN_RCV | VIRTIO_VSOCK_SHUTDOWN_SEND);
+    } else {
+        rv_send(c, VIRTIO_VSOCK_OP_RST, 0);
+        rv_conn_free(c);
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* 内置服务（端口 5000）                                                 */
+/* ------------------------------------------------------------------ */
+
+/* qemud 帧："%04x" 长度 + 负载 */
+static void rv_qemud_send(RvConn *c, const char *msg, size_t len)
+{
+    char hdr[8];
+    snprintf(hdr, sizeof(hdr), "%04zx", len);
+    rv_send_data(c, (const uint8_t *)hdr, 4);
+    if (len) {
+        rv_send_data(c, (const uint8_t *)msg, len);
+    }
+}
+
+/* 从 c->in 里取一个 qemud 帧；没有完整帧返回 NULL（调用方 g_free） */
+static char *rv_qemud_take(RvConn *c)
+{
+    if (c->in->len < 4) {
+        return NULL;
+    }
+    char hdr[5];
+    memcpy(hdr, c->in->data, 4);
+    hdr[4] = 0;
+    size_t flen = strtoul(hdr, NULL, 16);
+    if (c->in->len < 4 + flen) {
+        return NULL;
+    }
+    char *msg = g_strndup((const char *)c->in->data + 4, flen);
+    g_byte_array_remove_range(c->in, 0, 4 + flen);
+    return msg;
+}
+
+/* ---- qemud:sensors（协议在 ranchu-sensors.c） ---- */
+
+static void rv_sensors_send(void *opaque, const uint8_t *data, size_t len)
+{
+    rv_send_data(opaque, data, len);
+}
+
+static void rv_sensors_open(RvConn *c)
+{
+    c->svc_priv = ranchu_sensors_new(rv_sensors_send, c);
+}
+
+static void rv_sensors_recv(RvConn *c, const uint8_t *data, size_t len)
+{
+    ranchu_sensors_recv(c->svc_priv, data, len);
+}
+
+static void rv_sensors_close(RvConn *c)
+{
+    ranchu_sensors_free(c->svc_priv);
+}
+
+/* ---- qemud:boot-properties：qemu-props 发 "list"，逐帧回 "键=值"，单个 NUL 帧结束 ---- */
+
+static void rv_bootprops_recv(RvConn *c, const uint8_t *data, size_t len)
+{
+    g_byte_array_append(c->in, data, len);
+    char *msg;
+    while ((msg = rv_qemud_take(c))) {
+        if (strcmp(msg, "list") == 0) {
+            if (c->dev->boot_props && *c->dev->boot_props) {
+                g_auto(GStrv) items = g_strsplit(c->dev->boot_props, ";", 0);
+                for (int i = 0; items[i]; i++) {
+                    if (strchr(items[i], '=')) {
+                        rv_qemud_send(c, items[i], strlen(items[i]));
+                    }
+                }
+            }
+            rv_qemud_send(c, "", 1);    /* 含结尾 NUL 的空串 = 列表结束 */
+        }
+        g_free(msg);
+    }
+}
+
+/*
+ * 向本机 adb server（127.0.0.1:5037）登记 "host:emulator:<端口>"，与官方模拟器相同：
+ * adb server 随即连到该端口（即我们的转发口），设备显示为 emulator-<端口-1>。
+ * adb server 没开时连接直接被拒，忽略即可；重复登记是无害的。
+ */
+/* 向本机 adb server（127.0.0.1:5037）发一条 smart-socket 请求；server 没开时忽略 */
+static void rv_adb_server_cmd(const char *msg)
+{
+    struct sockaddr_in sa = {
+        .sin_family = AF_INET,
+        .sin_port = htons(5037),
+        .sin_addr.s_addr = htonl(INADDR_LOOPBACK),
+    };
+    char req[80];
+    int fd = qemu_socket(AF_INET, SOCK_STREAM, 0);
+
+    if (fd < 0) {
+        return;
+    }
+    if (connect(fd, (struct sockaddr *)&sa, sizeof(sa)) == 0) {
+        snprintf(req, sizeof(req), "%04zx%s", strlen(msg), msg);
+        if (send(fd, req, strlen(req), 0) < 0) {
+            /* 忽略 */
+        }
+    }
+    rv_close_sock(fd);
+}
+
+/*
+ * 与官方模拟器相同，向 adb server 登记 "host:emulator:<端口>"：server 随即连到该端口
+ * （即我们的转发口），设备显示为 emulator-<端口-1>。若 server 里还留着上一次运行的同名
+ * offline 传输，登记会被忽略，所以在没有活动 adb 连接时先发 host:reconnect-offline。
+ */
+static void rv_adb_register(RanchuVsock *s)
+{
+    for (guint i = 0; i < s->forwards->len; i++) {
+        RvForward *f = g_ptr_array_index(s->forwards, i);
+        RvConn *c;
+        bool live = false;
+
+        if (f->guest_port != 5555) {
+            continue;
+        }
+        QTAILQ_FOREACH(c, &s->conns, next) {
+            if (c->sock >= 0 && c->peer_port == f->guest_port && c->state == RV_CONNECTED) {
+                live = true;
+            }
+        }
+        if (live) {
+            continue;
+        }
+        char msg[40];
+        snprintf(msg, sizeof(msg), "host:emulator:%u", f->host_port);
+        RV_DBG(s, "向 adb server 登记 %s", msg);
+        rv_adb_server_cmd("host:reconnect-offline");
+        rv_adb_server_cmd(msg);
+    }
+}
+
+/* ---- QemuMiscPipe：[int32 长度][含 NUL 的消息]，回 [int32 0]；bootcomplete 打到宿主日志 ---- */
+
+static void rv_misc_recv(RvConn *c, const uint8_t *data, size_t len)
+{
+    g_byte_array_append(c->in, data, len);
+    while (c->in->len >= 4) {
+        int32_t mlen = ldl_le_p(c->in->data);
+        if (mlen < 0 || mlen > 4096) {
+            g_byte_array_set_size(c->in, 0);
+            return;
+        }
+        if (c->in->len < 4 + (guint)mlen) {
+            return;
+        }
+        g_autofree char *msg = g_strndup((const char *)c->in->data + 4, mlen);
+        g_byte_array_remove_range(c->in, 0, 4 + mlen);
+        if (strcmp(msg, "bootcomplete") == 0) {
+            info_report("ranchu: guest boot completed");
+            c->dev->boot_completed = true;
+            /* 开机完成时 adbd 可能因 usb 配置变化重启一次，稍等再登记 */
+            timer_mod(c->dev->adb_reg_timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 3000);
+            if (c->dev->boot_cmd && *c->dev->boot_cmd) {
+                c->dev->boot_cmd_tries = 0;
+                timer_mod(c->dev->boot_cmd_timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 4000);
+            }
+        } else if (strcmp(msg, "heartbeat") == 0) {
+            rv_adb_register(c->dev);    /* adb server 后启动/重启时也能在 30 秒内发现模拟器 */
+        }
+        uint8_t zero[4] = {0, 0, 0, 0};
+        rv_send_data(c, zero, sizeof(zero));
+    }
+}
+
+/* ---- clipboard：[uint32 LE 长度][UTF-8 文本]，双向 ---- */
+
+#ifdef _WIN32
+/*
+ * 宿主剪贴板桥：独立线程持有一个 message-only 窗口，负责 SetClipboardData（窗口所有权要求）
+ * 和 WM_CLIPBOARDUPDATE 监听；宿主侧变化经 BH 回到主循环再发给 guest。窗口必须在有消息
+ * 循环的线程里，否则别的进程清空剪贴板时向我们 SendMessage 会被卡住。
+ */
+#define RV_WM_SET_TEXT (WM_APP + 1)
+
+typedef struct RvClipboard {
+    RanchuVsock *dev;
+    HWND hwnd;
+    QemuMutex lock;
+    char *to_guest;             /* 剪贴板线程 -> 主循环 */
+    QEMUBH *bh;
+    bool suppress_update;       /* 忽略自己 SetClipboardData 引发的那次通知 */
+} RvClipboard;
+
+static void rv_clip_set_host_text(RvClipboard *cb, gunichar2 *w)
+{
+    size_t n = 0;
+    int tries = 0;
+    while (w[n]) {
+        n++;
+    }
+    while (!OpenClipboard(cb->hwnd)) {
+        if (++tries >= 10) {
+            return;
+        }
+        Sleep(20);
+    }
+    EmptyClipboard();
+    HGLOBAL h = GlobalAlloc(GMEM_MOVEABLE, (n + 1) * sizeof(gunichar2));
+    if (h) {
+        memcpy(GlobalLock(h), w, (n + 1) * sizeof(gunichar2));
+        GlobalUnlock(h);
+        if (SetClipboardData(CF_UNICODETEXT, h)) {
+            cb->suppress_update = true;
+        } else {
+            GlobalFree(h);
+        }
+    }
+    CloseClipboard();
+}
+
+static void rv_clip_read_host_text(RvClipboard *cb)
+{
+    char *utf8 = NULL;
+    int tries = 0;
+    while (!OpenClipboard(cb->hwnd)) {
+        if (++tries >= 10) {
+            return;
+        }
+        Sleep(20);
+    }
+    HANDLE h = GetClipboardData(CF_UNICODETEXT);
+    if (h) {
+        const gunichar2 *w = GlobalLock(h);
+        if (w) {
+            utf8 = g_utf16_to_utf8(w, -1, NULL, NULL, NULL);
+            GlobalUnlock(h);
+        }
+    }
+    CloseClipboard();
+    if (utf8) {
+        qemu_mutex_lock(&cb->lock);
+        g_free(cb->to_guest);
+        cb->to_guest = utf8;
+        qemu_mutex_unlock(&cb->lock);
+        qemu_bh_schedule(cb->bh);
+    }
+}
+
+static LRESULT CALLBACK rv_clip_wndproc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    RvClipboard *cb = (RvClipboard *)GetWindowLongPtrW(hwnd, GWLP_USERDATA);
+
+    switch (msg) {
+    case RV_WM_SET_TEXT:
+        rv_clip_set_host_text(cb, (gunichar2 *)lp);
+        g_free((gunichar2 *)lp);
+        return 0;
+    case WM_CLIPBOARDUPDATE:
+        if (cb && cb->suppress_update) {
+            cb->suppress_update = false;
+        } else if (cb) {
+            /*
+             * 不在通知里立刻读：很多程序（如 PowerShell Set-Clipboard）写剪贴板要先清空再写入，
+             * 两次 OpenClipboard 之间我们若抢着打开，对方第二次就会失败。延迟一点再读。
+             */
+            SetTimer(hwnd, 1, 150, NULL);
+        }
+        return 0;
+    case WM_TIMER:
+        KillTimer(hwnd, 1);
+        if (cb) {
+            rv_clip_read_host_text(cb);
+        }
+        return 0;
+    default:
+        return DefWindowProcW(hwnd, msg, wp, lp);
+    }
+}
+
+static DWORD WINAPI rv_clip_thread(LPVOID arg)
+{
+    RvClipboard *cb = arg;
+    WNDCLASSW wc = { 0 };
+    MSG msg;
+
+    wc.lpfnWndProc = rv_clip_wndproc;
+    wc.hInstance = GetModuleHandleW(NULL);
+    wc.lpszClassName = L"RanchuWoAClipboard";
+    RegisterClassW(&wc);
+    HWND hwnd = CreateWindowExW(0, wc.lpszClassName, L"", 0, 0, 0, 0, 0,
+                                HWND_MESSAGE, NULL, wc.hInstance, NULL);
+    if (!hwnd) {
+        return 1;
+    }
+    SetWindowLongPtrW(hwnd, GWLP_USERDATA, (LONG_PTR)cb);
+    cb->hwnd = hwnd;
+    AddClipboardFormatListener(hwnd);
+    while (GetMessageW(&msg, NULL, 0, 0) > 0) {
+        TranslateMessage(&msg);
+        DispatchMessageW(&msg);
+    }
+    return 0;
+}
+
+static void rv_clip_bh(void *opaque)
+{
+    RvClipboard *cb = opaque;
+    RvConn *c = cb->dev->clip_conn;
+
+    qemu_mutex_lock(&cb->lock);
+    char *text = cb->to_guest;
+    cb->to_guest = NULL;
+    qemu_mutex_unlock(&cb->lock);
+    if (text && c) {
+        uint8_t hdr[4];
+        stl_le_p(hdr, strlen(text));
+        rv_send_data(c, hdr, 4);
+        rv_send_data(c, (const uint8_t *)text, strlen(text));
+    }
+    g_free(text);
+}
+
+static void rv_clip_init(RanchuVsock *s)
+{
+    RvClipboard *cb = g_new0(RvClipboard, 1);
+    cb->dev = s;
+    qemu_mutex_init(&cb->lock);
+    cb->bh = qemu_bh_new(rv_clip_bh, cb);
+    CloseHandle(CreateThread(NULL, 0, rv_clip_thread, cb, 0, NULL));
+    s->clip = cb;
+}
+
+static void rv_clip_to_host(RanchuVsock *s, const char *utf8, size_t len)
+{
+    RvClipboard *cb = s->clip;
+    if (!cb || !cb->hwnd) {
+        return;
+    }
+    gunichar2 *w = g_utf8_to_utf16(utf8, len, NULL, NULL, NULL);
+    if (w) {
+        PostMessageW(cb->hwnd, RV_WM_SET_TEXT, 0, (LPARAM)w);
+    }
+}
+#else
+static void rv_clip_init(RanchuVsock *s)
+{
+}
+
+static void rv_clip_to_host(RanchuVsock *s, const char *utf8, size_t len)
+{
+}
+#endif
+
+static void rv_adb_reg_timer_cb(void *opaque)
+{
+    rv_adb_register(opaque);
+}
+
+static void rv_clip_open(RvConn *c)
+{
+    c->dev->clip_conn = c;
+}
+
+static void rv_clip_recv(RvConn *c, const uint8_t *data, size_t len)
+{
+    g_byte_array_append(c->in, data, len);
+    while (c->in->len >= 4) {
+        uint32_t mlen = ldl_le_p(c->in->data);
+        if (mlen > 16 * 1024 * 1024) {
+            g_byte_array_set_size(c->in, 0);
+            return;
+        }
+        if (c->in->len < 4 + mlen) {
+            return;
+        }
+        rv_clip_to_host(c->dev, (const char *)c->in->data + 4, mlen);
+        g_byte_array_remove_range(c->in, 0, 4 + mlen);
+    }
+}
+
+static void rv_clip_close(RvConn *c)
+{
+    if (c->dev->clip_conn == c) {
+        c->dev->clip_conn = NULL;
+    }
+}
+
+/*
+ * ---- qemud:camera：查询是以 NUL 结尾的裸字符串（不带 qemud 帧），
+ * 回复为 "%08x" 长度 + "ok:<数据>" / "ok\0" / "ko..."（见相机 HAL 的 qemu_channel.cpp）----
+ */
+
+static void rv_camera_reply(RvConn *c, const char *body, size_t len)
+{
+    char hdr[16];
+    snprintf(hdr, sizeof(hdr), "%08zx", len);
+    rv_send_data(c, (const uint8_t *)hdr, 8);
+    rv_send_data(c, (const uint8_t *)body, len);
+}
+
+static void rv_camera_recv(RvConn *c, const uint8_t *data, size_t len)
+{
+    g_byte_array_append(c->in, data, len);
+    for (;;) {
+        const uint8_t *nul = c->in->len ? memchr(c->in->data, 0, c->in->len) : NULL;
+        if (!nul) {
+            return;
+        }
+        size_t qlen = nul - c->in->data;
+        bool is_list = qlen == 4 && memcmp(c->in->data, "list", 4) == 0;
+        g_byte_array_remove_range(c->in, 0, qlen + 1);
+        /*
+         * 没有宿主摄像头：list 回只含结尾 NUL 的空列表，相机 HAL 就不注册 QEMU 摄像头；
+         * 其余查询只会发给列表里的摄像头，一律 ko
+         */
+        if (is_list) {
+            rv_camera_reply(c, "ok:", 4);   /* 含结尾 NUL */
+        } else {
+            rv_camera_reply(c, "ko", 3);
+        }
+    }
+}
+
+/*
+ * ---- qemud:gps：GNSS HAL 在有应用请求定位时连上来，读 NMEA 语句（自己按 '$' 和换行切分）。
+ * 每秒推一组 $GPGGA（海拔、卫星数）+ $GPRMC（经纬度），位置固定为 gps 属性 ----
+ */
+
+typedef struct RvGps {
+    RvConn *conn;
+    QEMUTimer *timer;
+} RvGps;
+
+static void rv_nmea_send(RvConn *c, const char *body)
+{
+    uint8_t sum = 0;
+    for (const char *p = body; *p; p++) {
+        sum ^= (uint8_t)*p;
+    }
+    g_autofree char *line = g_strdup_printf("$%s*%02X\r\n", body, sum);
+    rv_send_data(c, (const uint8_t *)line, strlen(line));
+}
+
+/* 十进制度数 -> NMEA 的 "ddmm.mmmm,N"（经度是 dddmm.mmmm） */
+static char *rv_nmea_coord(double deg, int deg_digits, char pos, char neg)
+{
+    char hemi = deg < 0 ? neg : pos;
+    double a = fabs(deg);
+    int d = (int)a;
+    double m = MIN((a - d) * 60.0, 59.9999);
+    return g_strdup_printf("%0*d%07.4f,%c", deg_digits, d, m, hemi);
+}
+
+static void rv_gps_tick(void *opaque)
+{
+    RvGps *g = opaque;
+    RanchuVsock *s = g->conn->dev;
+    g_autoptr(GDateTime) now = g_date_time_new_now_utc();
+    int hms = g_date_time_get_hour(now) * 10000 + g_date_time_get_minute(now) * 100 +
+              g_date_time_get_second(now);
+    int dmy = g_date_time_get_day_of_month(now) * 10000 + g_date_time_get_month(now) * 100 +
+              g_date_time_get_year(now) % 100;
+    g_autofree char *lat = rv_nmea_coord(s->gps_lat, 2, 'N', 'S');
+    g_autofree char *lon = rv_nmea_coord(s->gps_lon, 3, 'E', 'W');
+    g_autofree char *gga = g_strdup_printf("GPGGA,%06d,%s,%s,1,8,0.9,%.1f,M,0.0,M,,",
+                                           hms, lat, lon, s->gps_alt);
+    g_autofree char *rmc = g_strdup_printf("GPRMC,%06d,A,%s,%s,0.0,0.0,%06d,0.0,E",
+                                           hms, lat, lon, dmy);
+    rv_nmea_send(g->conn, gga);     /* 先 GGA：HAL 记下海拔，随后的 RMC 定位会带上 */
+    rv_nmea_send(g->conn, rmc);
+    timer_mod(g->timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 1000);
+}
+
+static void rv_gps_open(RvConn *c)
+{
+    RvGps *g = g_new0(RvGps, 1);
+    g->conn = c;
+    g->timer = timer_new_ms(QEMU_CLOCK_REALTIME, rv_gps_tick, g);
+    c->svc_priv = g;
+    timer_mod(g->timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 200);
+}
+
+static void rv_gps_close(RvConn *c)
+{
+    RvGps *g = c->svc_priv;
+    timer_free(g->timer);
+    g_free(g);
+}
+
+/*
+ * ---- 宿主发起的 adb 客户端：经 guest adbd 执行 shell 命令（正常关机、开机命令） ----
+ * 模拟器镜像 ro.adb.secure=0，adbd 在 vsock:5555 上无需认证：CNXN 握手后 OPEN 一条 shell 命令。
+ * 协议见 AOSP packages/modules/adb/protocol.txt：24 字节小端头
+ * {命令, arg0, arg1, 负载长度, 负载字节和, 命令 ^ 0xffffffff} + 负载。
+ */
+#define ADB_CNXN    0x4e584e43
+#define ADB_AUTH    0x48545541
+#define ADB_OPEN    0x4e45504f
+#define ADB_OKAY    0x59414b4f
+#define ADB_WRTE    0x45545257
+#define ADB_CLSE    0x45534c43
+#define ADB_VERSION 0x01000001
+#define ADB_MAXDATA (256 * 1024)
+#define ADB_LOCAL_ID 1
+#define RV_BOOT_CMD_TRIES 5
+
+/* 一次宿主发起的 shell 命令（连接的 svc_priv） */
+typedef struct RvAdbCmd {
+    char *service;              /* "shell:<命令>" */
+    const char *what;           /* 日志用的说明 */
+    bool boot;                  /* 开机命令：adbd 还没起来（连接被 RST）时稍后重试 */
+    bool accepted;              /* adbd 已回 OKAY，命令在跑 */
+    bool give_up;               /* adbd 要求认证，重试也没用 */
+} RvAdbCmd;
+
+static void rv_adb_msg(RvConn *c, uint32_t cmd, uint32_t arg0, uint32_t arg1,
+                       const char *data, uint32_t len)
+{
+    uint8_t h[24];
+    uint32_t sum = 0;
+
+    for (uint32_t i = 0; i < len; i++) {
+        sum += (uint8_t)data[i];
+    }
+    stl_le_p(h, cmd);
+    stl_le_p(h + 4, arg0);
+    stl_le_p(h + 8, arg1);
+    stl_le_p(h + 12, len);
+    stl_le_p(h + 16, sum);
+    stl_le_p(h + 20, cmd ^ 0xffffffff);
+    rv_send_data(c, h, sizeof(h));
+    if (len) {
+        rv_send_data(c, (const uint8_t *)data, len);
+    }
+}
+
+/* vsock 连接建立（guest 回 RESPONSE）后调用 */
+static void rv_adbctl_open(RvConn *c)
+{
+    static const char banner[] = "host::";
+    rv_adb_msg(c, ADB_CNXN, ADB_VERSION, ADB_MAXDATA, banner, sizeof(banner));
+}
+
+static void rv_adbctl_recv(RvConn *c, const uint8_t *data, size_t len)
+{
+    RvAdbCmd *a = c->svc_priv;
+
+    g_byte_array_append(c->in, data, len);
+    while (c->in->len >= 24) {
+        uint32_t cmd = ldl_le_p(c->in->data);
+        uint32_t arg0 = ldl_le_p(c->in->data + 4);
+        uint32_t plen = ldl_le_p(c->in->data + 12);
+        if (plen > ADB_MAXDATA) {
+            g_byte_array_set_size(c->in, 0);
+            return;
+        }
+        if (c->in->len < 24 + plen) {
+            return;
+        }
+        g_byte_array_remove_range(c->in, 0, 24 + plen);
+        switch (cmd) {
+        case ADB_CNXN:
+            info_report("ranchu-vsock: 经 adbd %s", a->what);
+            rv_adb_msg(c, ADB_OPEN, ADB_LOCAL_ID, 0, a->service, strlen(a->service) + 1);
+            break;
+        case ADB_AUTH:
+            warn_report("ranchu-vsock: guest adbd 要求认证（ro.adb.secure=1），没法%s", a->what);
+            a->give_up = true;
+            rv_conn_shutdown(c);        /* 仍是 CONNECTED：只发 SHUTDOWN，等 guest RST 再释放 */
+            return;
+        case ADB_OKAY:
+            a->accepted = true;
+            break;
+        case ADB_WRTE:
+            rv_adb_msg(c, ADB_OKAY, ADB_LOCAL_ID, arg0, NULL, 0);    /* 命令输出，确认后丢弃 */
+            break;
+        case ADB_CLSE:                  /* 命令跑完了 */
+            rv_adb_msg(c, ADB_CLSE, ADB_LOCAL_ID, arg0, NULL, 0);
+            rv_conn_shutdown(c);
+            return;
+        }
+    }
+}
+
+static void rv_adbctl_close(RvConn *c)
+{
+    RvAdbCmd *a = c->svc_priv;
+    RanchuVsock *s = c->dev;
+
+    /* 开机命令没被 adbd 接受（开机完成前后 adbd 会重启一次，这时连接被 RST）：过几秒再试 */
+    if (a->boot && !a->accepted && !a->give_up && s->boot_completed &&
+        s->boot_cmd_tries < RV_BOOT_CMD_TRIES) {
+        timer_mod(s->boot_cmd_timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 3000);
+    }
+    g_free(a->service);
+    g_free(a);
+}
+
+static const RvService rv_adbctl_service = {
+    "（宿主 adb 客户端）", rv_adbctl_open, rv_adbctl_recv, rv_adbctl_close
+};
+
+static uint32_t rv_next_port(RanchuVsock *s)
+{
+    uint32_t port = s->next_local_port++;
+    if (s->next_local_port < 49152) {
+        s->next_local_port = 49152;
+    }
+    return port;
+}
+
+/* 宿主发起一条 vsock 连接到 guest adbd，握手后执行 shell 命令 */
+static void rv_adb_shell(RanchuVsock *s, const char *cmd, const char *what, bool boot)
+{
+    RvAdbCmd *a = g_new0(RvAdbCmd, 1);
+    a->service = g_strconcat("shell:", cmd, NULL);
+    a->what = what;
+    a->boot = boot;
+
+    RvConn *c = rv_conn_new(s, rv_next_port(s), RV_ADBD_PORT);
+    c->svc = &rv_adbctl_service;
+    c->svc_priv = a;
+    c->name_done = true;                /* 不是 guest 发起的服务连接，没有服务名 */
+    c->in = g_byte_array_new();
+    rv_conn_connect(c);
+}
+
+/*
+ * 开机命令（boot-cmd 属性）：avdctl 用它补上没有开机向导的 GSI 不会写的 device_provisioned /
+ * user_setup_complete（为 0 时 Android 不响应主屏幕键和最近任务）。每次开机都执行，命令本身要幂等。
+ */
+static void rv_boot_cmd_timer_cb(void *opaque)
+{
+    RanchuVsock *s = opaque;
+
+    if (s->boot_completed && s->boot_cmd && *s->boot_cmd) {
+        s->boot_cmd_tries++;
+        rv_adb_shell(s, s->boot_cmd, "执行开机命令", true);
+    }
+}
+
+/* guest 开机完成后才有 adbd 可连；之前的关机请求交给板子的电源键 */
+static bool rv_poweroff_ready(RanchuVsock *s)
+{
+    return s->boot_completed && (VIRTIO_DEVICE(s)->status & VIRTIO_CONFIG_S_DRIVER_OK);
+}
+
+static void rv_powerdown_req(Notifier *n, void *opaque)
+{
+    RanchuVsock *s = container_of(n, RanchuVsock, powerdown);
+
+    if (!rv_poweroff_ready(s)) {
+        return;
+    }
+    /*
+     * svc power shutdown 走框架的 ShutdownThread（关机广播、AM/PM 收尾），与电源菜单的"关机"相同；
+     * 它在关机完成前不返回，失败（如 system_server 异常）时才退回 init 层的 reboot -p
+     */
+    rv_adb_shell(s, "svc power shutdown || reboot -p", "请求 guest 关机", false);
+}
+
+static const RvService rv_services[] = {
+    { "pipe:qemud:sensors", rv_sensors_open, rv_sensors_recv, rv_sensors_close },
+    { "pipe:qemud:boot-properties", NULL, rv_bootprops_recv, NULL },
+    { "pipe:QemuMiscPipe", NULL, rv_misc_recv, NULL },
+    { "pipe:clipboard", rv_clip_open, rv_clip_recv, rv_clip_close },
+    { "pipe:qemud:camera", NULL, rv_camera_recv, NULL },
+    { "pipe:qemud:gps", rv_gps_open, NULL, rv_gps_close },
+    /* 指纹 HAL 发 "listen" 后只等 "on:<指纹 id>"/"off" 事件；没有指纹输入就一直不发 */
+    { "pipe:qemud:fingerprintlisten", NULL, NULL, NULL },
+};
+
+/* 未实现的服务：保持连接、丢弃数据（RST 会让 guest 端在 EOF 上空转，见文件头） */
+static const RvService rv_silent_service = { "", NULL, NULL, NULL };
+
+static void rv_service_dispatch(RvConn *c)
+{
+    c->svc = &rv_silent_service;
+    for (size_t i = 0; i < ARRAY_SIZE(rv_services); i++) {
+        if (strcmp(c->name, rv_services[i].name) == 0) {
+            c->svc = &rv_services[i];
+            break;
+        }
+    }
+    if (c->svc == &rv_silent_service) {
+        info_report("ranchu-vsock: 未实现的服务 \"%s\"，保持连接并丢弃数据", c->name);
+    }
+    c->in = g_byte_array_new();
+    if (c->svc->open) {
+        c->svc->open(c);
+    }
+}
+
+static void rv_service_recv(RvConn *c, const uint8_t *data, size_t len)
+{
+    while (len > 0 && !c->name_done) {
+        uint8_t ch = *data++;
+        len--;
+        if (ch == 0) {
+            c->name[c->name_len] = 0;
+            c->name_done = true;
+            rv_service_dispatch(c);
+        } else if (c->name_len < sizeof(c->name) - 1) {
+            c->name[c->name_len++] = ch;
+        }
+    }
+    if (len > 0 && c->svc && c->svc->recv) {
+        c->svc->recv(c, data, len);
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* 宿主 TCP 转发                                                        */
+/* ------------------------------------------------------------------ */
+
+static void rv_sock_update_handlers(RvConn *c)
+{
+    bool want_read = c->state == RV_CONNECTED && rv_peer_credit(c) > 0;
+    bool want_write = c->sock_out && c->sock_out->len > 0;
+    c->sock_reading = want_read;
+    qemu_set_fd_handler(c->sock, want_read ? rv_sock_readable : NULL,
+                        want_write ? rv_sock_writable : NULL, c);
+}
+
+static void rv_sock_readable(void *opaque)
+{
+    RvConn *c = opaque;
+    uint8_t buf[RV_MAX_PAYLOAD * 4];
+    uint32_t credit = rv_peer_credit(c);
+
+    if (credit == 0) {
+        rv_sock_update_handlers(c);
+        return;
+    }
+    ssize_t r = recv(c->sock, (char *)buf, MIN(sizeof(buf), credit), 0);
+    if (r > 0) {
+        rv_send_data(c, buf, r);
+        rv_sock_update_handlers(c);
+    } else if (r == 0 || (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)) {
+        RV_DBG(c->dev, "宿主 socket 关闭（本端 %u，r=%zd）", c->local_port, r);
+        rv_conn_shutdown(c);
+    }
+}
+
+static void rv_sock_writable(void *opaque)
+{
+    RvConn *c = opaque;
+
+    while (c->sock_out && c->sock_out->len > 0) {
+        ssize_t r = send(c->sock, (const char *)c->sock_out->data, c->sock_out->len, 0);
+        if (r > 0) {
+            g_byte_array_remove_range(c->sock_out, 0, r);
+        } else if (r < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) {
+            break;
+        } else {
+            rv_conn_shutdown(c);
+            return;
+        }
+    }
+    rv_sock_update_handlers(c);
+}
+
+static void rv_sock_deliver(RvConn *c, const uint8_t *data, size_t len)
+{
+    if (c->sock < 0) {
+        return;
+    }
+    if (!c->sock_out) {
+        c->sock_out = g_byte_array_new();
+    }
+    g_byte_array_append(c->sock_out, data, len);
+    rv_sock_writable(c);
+}
+
+static void rv_forward_accept(void *opaque)
+{
+    RvForward *f = opaque;
+    RanchuVsock *s = f->dev;
+    VirtIODevice *vdev = VIRTIO_DEVICE(s);
+
+    for (;;) {                          /* 一次取完 backlog（监听 socket 是非阻塞的） */
+        struct sockaddr_in sa;
+        socklen_t slen = sizeof(sa);
+        int fd = accept(f->listen_fd, (struct sockaddr *)&sa, &slen);
+
+        if (fd < 0) {
+            return;
+        }
+        if (!(vdev->status & VIRTIO_CONFIG_S_DRIVER_OK)) {
+            rv_close_sock(fd);    /* guest 驱动还没起来 */
+            continue;
+        }
+        qemu_set_blocking(fd, false, NULL);
+        RvConn *c = rv_conn_new(s, rv_next_port(s), f->guest_port);
+        c->sock = fd;
+        RV_DBG(s, "宿主 %u 连入，向 guest:%u 发 REQUEST（本端 %u）", f->host_port, f->guest_port,
+               c->local_port);
+        rv_conn_connect(c);
+    }
+}
+
+static void rv_forward_setup(RanchuVsock *s, Error **errp)
+{
+    if (!s->forward || !*s->forward) {
+        return;
+    }
+    g_auto(GStrv) items = g_strsplit(s->forward, ";", 0);
+    for (int i = 0; items[i]; i++) {
+        unsigned hp, gp;
+        if (sscanf(items[i], "%u:%u", &hp, &gp) != 2 || !hp || hp > 65535) {
+            error_setg(errp, "ranchu-vsock: forward 格式应为 <宿主端口>:<guest 端口>[;...]，得到 \"%s\"",
+                       items[i]);
+            return;
+        }
+        struct sockaddr_in sa = {
+            .sin_family = AF_INET,
+            .sin_port = htons(hp),
+            .sin_addr.s_addr = htonl(INADDR_LOOPBACK),
+        };
+        int fd = qemu_socket(AF_INET, SOCK_STREAM, 0);
+        if (fd < 0 || bind(fd, (struct sockaddr *)&sa, sizeof(sa)) < 0 || listen(fd, 8) < 0) {
+            error_setg(errp, "ranchu-vsock: 无法监听 127.0.0.1:%u", hp);
+            if (fd >= 0) {
+                close(fd);
+            }
+            return;
+        }
+        qemu_set_blocking(fd, false, NULL);
+        RvForward *f = g_new0(RvForward, 1);
+        f->dev = s;
+        f->listen_fd = fd;
+        f->host_port = hp;
+        f->guest_port = gp;
+        g_ptr_array_add(s->forwards, f);
+        qemu_set_fd_handler(fd, rv_forward_accept, NULL, f);
+        info_report("ranchu-vsock: 127.0.0.1:%u -> guest vsock:%u", hp, gp);
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* guest -> 宿主                                                        */
+/* ------------------------------------------------------------------ */
+
+static void rv_handle_packet(RanchuVsock *s, const struct virtio_vsock_hdr *h,
+                             const uint8_t *data)
+{
+    uint16_t op = le16_to_cpu(h->op);
+    uint32_t src_port = le32_to_cpu(h->src_port);
+    uint32_t dst_port = le32_to_cpu(h->dst_port);
+    uint32_t len = le32_to_cpu(h->len);
+
+    if (le64_to_cpu(h->dst_cid) != RV_HOST_CID ||
+        le16_to_cpu(h->type) != VIRTIO_VSOCK_TYPE_STREAM) {
+        if (op != VIRTIO_VSOCK_OP_RST) {
+            rv_queue_raw(s, dst_port, src_port, VIRTIO_VSOCK_OP_RST, 0, 0, NULL, 0);
+        }
+        return;
+    }
+
+    RvConn *c = rv_find(s, dst_port, src_port);
+    if (c) {
+        c->peer_buf_alloc = le32_to_cpu(h->buf_alloc);
+        c->peer_fwd_cnt = le32_to_cpu(h->fwd_cnt);
+    }
+    if (op != VIRTIO_VSOCK_OP_RW && op != VIRTIO_VSOCK_OP_CREDIT_UPDATE) {
+        RV_DBG(s, "guest op=%u %u->%u flags=%u conn=%p state=%d", op, src_port, dst_port,
+               le32_to_cpu(h->flags), c, c ? (int)c->state : -1);
+    }
+
+    switch (op) {
+    case VIRTIO_VSOCK_OP_REQUEST:
+        if (c || dst_port != RV_PIPE_PORT) {
+            rv_queue_raw(s, dst_port, src_port, VIRTIO_VSOCK_OP_RST, 0, 0, NULL, 0);
+            return;
+        }
+        c = rv_conn_new(s, dst_port, src_port);
+        c->peer_buf_alloc = le32_to_cpu(h->buf_alloc);
+        c->peer_fwd_cnt = le32_to_cpu(h->fwd_cnt);
+        c->state = RV_CONNECTED;
+        rv_send(c, VIRTIO_VSOCK_OP_RESPONSE, 0);
+        break;
+    case VIRTIO_VSOCK_OP_RESPONSE:
+        if (!c || c->state != RV_CONNECTING) {
+            rv_queue_raw(s, dst_port, src_port, VIRTIO_VSOCK_OP_RST, 0, 0, NULL, 0);
+            return;
+        }
+        c->state = RV_CONNECTED;
+        if (c->sock >= 0) {
+            rv_sock_update_handlers(c);
+        } else if (c->svc && c->svc->open) {
+            c->svc->open(c);                /* 宿主发起的内置客户端（如关机用的 adb 客户端） */
+        }
+        break;
+    case VIRTIO_VSOCK_OP_RW:
+        if (!c || c->state != RV_CONNECTED) {
+            if (!c) {
+                rv_queue_raw(s, dst_port, src_port, VIRTIO_VSOCK_OP_RST, 0, 0, NULL, 0);
+            }
+            return;
+        }
+        c->fwd_cnt += len;
+        if (c->sock >= 0) {
+            rv_sock_deliver(c, data, len);
+        } else {
+            rv_service_recv(c, data, len);
+        }
+        if (c && c->fwd_cnt - c->credit_sent_fwd > RV_BUF_ALLOC / 4) {
+            rv_send(c, VIRTIO_VSOCK_OP_CREDIT_UPDATE, 0);
+        }
+        break;
+    case VIRTIO_VSOCK_OP_CREDIT_UPDATE:
+        if (c && c->sock >= 0 && c->state == RV_CONNECTED) {
+            rv_sock_update_handlers(c);
+        }
+        break;
+    case VIRTIO_VSOCK_OP_CREDIT_REQUEST:
+        if (c) {
+            rv_send(c, VIRTIO_VSOCK_OP_CREDIT_UPDATE, 0);
+        }
+        break;
+    case VIRTIO_VSOCK_OP_SHUTDOWN:
+        if (c) {
+            rv_send(c, VIRTIO_VSOCK_OP_RST, 0);
+            rv_conn_free(c);
+        }
+        break;
+    case VIRTIO_VSOCK_OP_RST:
+        if (c) {
+            rv_conn_free(c);
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+static void rv_handle_tx(VirtIODevice *vdev, VirtQueue *vq)
+{
+    RanchuVsock *s = RANCHU_VSOCK(vdev);
+    VirtQueueElement *elem;
+
+    while ((elem = virtqueue_pop(vq, sizeof(VirtQueueElement)))) {
+        struct virtio_vsock_hdr h;
+        size_t total = iov_size(elem->out_sg, elem->out_num);
+        if (total >= sizeof(h)) {
+            iov_to_buf(elem->out_sg, elem->out_num, 0, &h, sizeof(h));
+            uint32_t len = le32_to_cpu(h.len);
+            if (len <= total - sizeof(h) && len <= 64 * 1024) {
+                g_autofree uint8_t *data = len ? g_malloc(len) : NULL;
+                if (len) {
+                    iov_to_buf(elem->out_sg, elem->out_num, sizeof(h), data, len);
+                }
+                rv_handle_packet(s, &h, data);
+            }
+        }
+        virtqueue_push(vq, elem, 0);
+        g_free(elem);
+    }
+    virtio_notify(vdev, vq);
+    rv_flush_rx(s);
+}
+
+static void rv_handle_rx(VirtIODevice *vdev, VirtQueue *vq)
+{
+    rv_flush_rx(RANCHU_VSOCK(vdev));
+}
+
+static void rv_handle_evt(VirtIODevice *vdev, VirtQueue *vq)
+{
+}
+
+/* ------------------------------------------------------------------ */
+/* 设备                                                                */
+/* ------------------------------------------------------------------ */
+
+static void rv_drop_all(RanchuVsock *s)
+{
+    while (!QTAILQ_EMPTY(&s->conns)) {
+        rv_conn_free(QTAILQ_FIRST(&s->conns));
+    }
+    while (!QSIMPLEQ_EMPTY(&s->rxq)) {
+        RvPkt *p = QSIMPLEQ_FIRST(&s->rxq);
+        QSIMPLEQ_REMOVE_HEAD(&s->rxq, next);
+        g_free(p->data);
+        g_free(p);
+    }
+}
+
+static void rv_get_config(VirtIODevice *vdev, uint8_t *config)
+{
+    RanchuVsock *s = RANCHU_VSOCK(vdev);
+    struct virtio_vsock_config cfg = {};
+
+    cfg.guest_cid = cpu_to_le64(s->guest_cid);
+    memcpy(config, &cfg, sizeof(cfg));
+}
+
+static uint64_t rv_get_features(VirtIODevice *vdev, uint64_t f, Error **errp)
+{
+    return f;
+}
+
+static int rv_set_status(VirtIODevice *vdev, uint8_t status)
+{
+    RanchuVsock *s = RANCHU_VSOCK(vdev);
+
+    if (status & VIRTIO_CONFIG_S_DRIVER_OK) {
+        rv_flush_rx(s);
+    }
+    return 0;
+}
+
+static void rv_reset(VirtIODevice *vdev)
+{
+    RanchuVsock *s = RANCHU_VSOCK(vdev);
+
+    s->boot_completed = false;          /* 先清：丢弃连接时开机命令不会再排重试 */
+    timer_del(s->boot_cmd_timer);
+    rv_drop_all(s);
+}
+
+static void rv_realize(DeviceState *dev, Error **errp)
+{
+    VirtIODevice *vdev = VIRTIO_DEVICE(dev);
+    RanchuVsock *s = RANCHU_VSOCK(dev);
+
+    if (s->guest_cid <= 2 || s->guest_cid >= UINT32_MAX) {
+        error_setg(errp, "ranchu-vsock: guest-cid 必须 > 2");
+        return;
+    }
+    QTAILQ_INIT(&s->conns);
+    QSIMPLEQ_INIT(&s->rxq);
+    s->forwards = g_ptr_array_new_with_free_func(g_free);
+    s->next_local_port = 49152;
+
+    virtio_init(vdev, VIRTIO_ID_VSOCK, sizeof(struct virtio_vsock_config));
+    s->rx_vq = virtio_add_queue(vdev, RV_QUEUE_SIZE, rv_handle_rx);
+    s->tx_vq = virtio_add_queue(vdev, RV_QUEUE_SIZE, rv_handle_tx);
+    s->evt_vq = virtio_add_queue(vdev, 16, rv_handle_evt);
+
+    s->adb_reg_timer = timer_new_ms(QEMU_CLOCK_REALTIME, rv_adb_reg_timer_cb, s);
+    s->boot_cmd_timer = timer_new_ms(QEMU_CLOCK_REALTIME, rv_boot_cmd_timer_cb, s);
+    s->powerdown.notify = rv_powerdown_req;
+    qemu_register_powerdown_notifier(&s->powerdown);
+    rv_clip_init(s);
+    rv_forward_setup(s, errp);
+}
+
+static void rv_unrealize(DeviceState *dev)
+{
+    VirtIODevice *vdev = VIRTIO_DEVICE(dev);
+    RanchuVsock *s = RANCHU_VSOCK(dev);
+
+    s->boot_completed = false;
+    rv_drop_all(s);
+    timer_free(s->boot_cmd_timer);
+    notifier_remove(&s->powerdown);
+    for (guint i = 0; i < s->forwards->len; i++) {
+        RvForward *f = g_ptr_array_index(s->forwards, i);
+        qemu_set_fd_handler(f->listen_fd, NULL, NULL, NULL);
+        close(f->listen_fd);
+    }
+    g_ptr_array_free(s->forwards, true);
+    virtio_delete_queue(s->rx_vq);
+    virtio_delete_queue(s->tx_vq);
+    virtio_delete_queue(s->evt_vq);
+    virtio_cleanup(vdev);
+}
