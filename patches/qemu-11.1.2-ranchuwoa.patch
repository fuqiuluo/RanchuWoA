+/*
+ * gps 属性 "纬度;经度[;海拔米]"：不是 qdev 静态属性，运行中也能改
+ * （QMP qom-set <设备路径> gps "31.23;121.47"），下一秒的 NMEA 就用新位置。
+ */
+static char *rv_get_gps(Object *obj, Error **errp)
+{
+    RanchuVsock *s = RANCHU_VSOCK(obj);
+    char lat[G_ASCII_DTOSTR_BUF_SIZE], lon[G_ASCII_DTOSTR_BUF_SIZE];
+    char alt[G_ASCII_DTOSTR_BUF_SIZE];
+
+    return g_strdup_printf("%s;%s;%s", g_ascii_dtostr(lat, sizeof(lat), s->gps_lat),
+                           g_ascii_dtostr(lon, sizeof(lon), s->gps_lon),
+                           g_ascii_dtostr(alt, sizeof(alt), s->gps_alt));
+}
+
+static void rv_set_gps(Object *obj, const char *value, Error **errp)
+{
+    RanchuVsock *s = RANCHU_VSOCK(obj);
+    g_auto(GStrv) v = g_strsplit(value, ";", 0);
+    guint n = g_strv_length(v);
+    char *e1 = NULL, *e2 = NULL, *e3 = NULL;
+    double lat = n >= 2 ? g_ascii_strtod(v[0], &e1) : NAN;
+    double lon = n >= 2 ? g_ascii_strtod(v[1], &e2) : NAN;
+    double alt = n >= 3 ? g_ascii_strtod(v[2], &e3) : s->gps_alt;
+
+    if (n < 2 || n > 3 || *e1 || *e2 || (e3 && *e3) ||
+        !(fabs(lat) <= 90) || !(fabs(lon) <= 180) || !isfinite(alt)) {
+        error_setg(errp, "ranchu-vsock: gps 格式应为 <纬度>;<经度>[;<海拔米>]，得到 \"%s\"", value);
+        return;
+    }
+    s->gps_lat = lat;
+    s->gps_lon = lon;
+    s->gps_alt = alt;
+}
+
+/* 只读：此时 system_powerdown 会由本设备经 adbd 正常关机（板子不必再按电源键，UI 关窗也可等 guest 关机） */
+static bool rv_get_poweroff_ready(Object *obj, Error **errp)
+{
+    return rv_poweroff_ready(RANCHU_VSOCK(obj));
+}
+
+static void rv_instance_init(Object *obj)
+{
+    RanchuVsock *s = RANCHU_VSOCK(obj);
+
+    /* 默认位置与官方模拟器相同（Google 总部） */
+    s->gps_lat = 37.4220;
+    s->gps_lon = -122.0841;
+    s->gps_alt = 5.0;
+}
+
+static void rv_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    VirtioDeviceClass *vdc = VIRTIO_DEVICE_CLASS(klass);
+
+    device_class_set_props(dc, rv_properties);
+    object_class_property_add_str(klass, "gps", rv_get_gps, rv_set_gps);
+    object_class_property_set_description(klass, "gps", "固定 GPS 位置：纬度;经度[;海拔米]");
+    object_class_property_add_bool(klass, "poweroff-ready", rv_get_poweroff_ready, NULL);
+    object_class_property_set_description(klass, "poweroff-ready",
+                                          "guest 已开机完成，system_powerdown 会经 adbd 正常关机");
+    dc->desc = "RanchuWoA userspace virtio-vsock (qemud services + TCP forward)";
+    set_bit(DEVICE_CATEGORY_MISC, dc->categories);
+    vdc->realize = rv_realize;
+    vdc->unrealize = rv_unrealize;
+    vdc->get_config = rv_get_config;
+    vdc->get_features = rv_get_features;
+    vdc->set_status = rv_set_status;
+    vdc->reset = rv_reset;
+}
