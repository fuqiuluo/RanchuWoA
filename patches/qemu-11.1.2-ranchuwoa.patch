+/*
+ * RanchuWoA: 竖屏手机分辨率（如 720x1280、1080x1920）经常比桌面可用区域还高。
+ * 初始窗口按可用区域等比缩小（渲染器用 SDL_RenderSetLogicalSize 保持比例，鼠标坐标
+ * 按窗口尺寸换算，所以缩放对 guest 透明）；窗口仍可自由拉伸。
+ */
+static void sdl2_fit_to_screen(struct sdl2_console *scon, int *w, int *h)
+{
+    SDL_Rect usable;
+    int sw = surface_width(scon->surface);
+    int sh = surface_height(scon->surface);
+
+    *w = sw;
+    *h = sh;
+    if (SDL_GetDisplayUsableBounds(0, &usable) != 0 || usable.w <= 0 || usable.h <= 0) {
+        return;
+    }
+    double scale = MIN(1.0, MIN(usable.w * 0.92 / sw, usable.h * 0.92 / sh));
+    *w = MAX(1, (int)(sw * scale));
+    *h = MAX(1, (int)(sh * scale));
+}
+
+/*
+ * RanchuWoA: 关窗 = 先请求 guest 正常关机（system_powerdown，ranchu-vsock 经 adbd 执行 svc power shutdown），
+ * guest 关好后 QEMU 自然退出。guest 还没开机完成时照旧立即退出；20 秒内没关掉、或用户过一会儿
+ * 再点一次关闭，就强制退出。
+ */
+#define SDL_CLOSE_TIMEOUT_MS 20000
+
+static void sdl_force_quit(void *opaque)
+{
+    shutdown_action = SHUTDOWN_ACTION_POWEROFF;
+    qemu_system_shutdown_request(SHUTDOWN_CAUSE_HOST_UI);
+}
+
+/*
+ * RanchuWoA: Ctrl+Alt+P 的电源键。按下后 100 ms 再松开：瞬时的按下/松开（间隔几微秒）AOSP 照样处理，
+ * 但 ColorOS 的输入策略会当成抖动忽略。
+ */
+static QEMUTimer *sdl_power_timer;
+static QemuConsole *sdl_power_con;
+
+static void sdl_power_key_release(void *opaque)
+{
+    qemu_input_event_send_key_linux(sdl_power_con, KEY_POWER, false);
+    qemu_input_event_sync();
+}
+
+static void sdl_power_key_press(struct sdl2_console *scon)
+{
+    if (!sdl_power_timer) {
+        sdl_power_timer = timer_new_ms(QEMU_CLOCK_REALTIME, sdl_power_key_release, NULL);
+    }
+    if (timer_pending(sdl_power_timer)) {
+        return;                         /* 上一次还没松开 */
+    }
+    sdl_power_con = scon->dcl.con;
+    qemu_input_event_send_key_linux(sdl_power_con, KEY_POWER, true);
+    qemu_input_event_sync();
+    timer_mod(sdl_power_timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 100);
+}
+
+static void sdl_request_close(void)
+{
+    int64_t now = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+    Object *rv;
+
+    if (sdl_close_requested_ms) {
+        /* 一次点击 SDL 会连发 WINDOWEVENT_CLOSE 和 QUIT；隔一会儿再点才算强制退出 */
+        if (now - sdl_close_requested_ms > 1000) {
+            sdl_force_quit(NULL);
+        }
+        return;
+    }
+    rv = object_resolve_path_type("", "ranchu-vsock-device", NULL);
+    if (!rv || !object_property_get_bool(rv, "poweroff-ready", NULL)) {
+        sdl_force_quit(NULL);
+        return;
+    }
+    sdl_close_requested_ms = now;
+    qemu_system_powerdown_request();
+    sdl_close_timer = timer_new_ms(QEMU_CLOCK_REALTIME, sdl_force_quit, NULL);
+    timer_mod(sdl_close_timer, now + SDL_CLOSE_TIMEOUT_MS);
+    for (int i = 0; i < sdl2_num_outputs; i++) {
+        sdl_update_caption(&sdl2_console[i]);
+    }
+}
