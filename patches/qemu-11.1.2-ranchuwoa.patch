--- a/hw/android/goldfish-address-space.c
+++ b/hw/android/goldfish-address-space.c
@@ -0,0 +1,305 @@
+/*
+ * goldfish-address-space.c — RanchuWoA goldfish address space PCI 设备
+ *
+ * PCI vendor 0x607D device 0xF153。gralloc/图形栈的共享内存通道：
+ *   BAR0 = 控制寄存器（52B），BAR1 = 64 位共享内存区（大小可配）。
+ * 协议与内核驱动 goldfish_drivers/goldfish_address_space.c 对齐：
+ *   ALLOCATE_BLOCK   : guest 写 size regs -> cmd=1 -> 读 offset regs
+ *   DEALLOCATE_BLOCK : guest 写 offset regs -> cmd=2
+ *   GEN/DESTROY_HANDLE, TELL_PING_INFO_ADDR: gfxstream 句柄/门铃（无渲染器时简化）
+ *   PHYS_START regs  : 返回 BAR1 的 guest 物理地址
+ */
+
+#include "qemu/osdep.h"
+#include "hw/pci/pci.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/pci/pci_device.h"
+#include "hw/pci/pci_ids.h"
+#include "qemu/error-report.h"
+#include "qom/object.h"
+
+#define GAS_DEBUG 0     /* 1：把寄存器写入打到 stderr */
+
+#define GAS_VENDOR_ID 0x607D
+#define GAS_DEVICE_ID 0xF153
+
+enum {
+    GAS_REG_COMMAND = 0x00,
+    GAS_REG_STATUS = 0x04,
+    GAS_REG_GUEST_PAGE_SIZE = 0x08,
+    GAS_REG_BLOCK_SIZE_LOW = 0x0C,
+    GAS_REG_BLOCK_SIZE_HIGH = 0x10,
+    GAS_REG_BLOCK_OFFSET_LOW = 0x14,
+    GAS_REG_BLOCK_OFFSET_HIGH = 0x18,
+    GAS_REG_PING = 0x1C,
+    GAS_REG_PING_INFO_ADDR_LOW = 0x20,
+    GAS_REG_PING_INFO_ADDR_HIGH = 0x24,
+    GAS_REG_HANDLE = 0x28,
+    GAS_REG_PHYS_START_LOW = 0x2C,
+    GAS_REG_PHYS_START_HIGH = 0x30,
+    GAS_REG_PING_WITH_DATA = 0x34,
+};
+
+enum {
+    GAS_CMD_ALLOCATE_BLOCK = 1,
+    GAS_CMD_DEALLOCATE_BLOCK = 2,
+    GAS_CMD_GEN_HANDLE = 3,
+    GAS_CMD_DESTROY_HANDLE = 4,
+    GAS_CMD_TELL_PING_INFO_ADDR = 5,
+};
+
+/* 简单块分配器：容量递增数组 + 请求计数的 bump 分配 */
+typedef struct GasBlock {
+    uint64_t offset;
+    uint64_t size;
+    bool used;
+} GasBlock;
+
+#define TYPE_GOLDFISH_ADDRESS_SPACE "goldfish-address-space"
+OBJECT_DECLARE_SIMPLE_TYPE(GasState, GOLDFISH_ADDRESS_SPACE)
+
+struct GasState {
+    PCIDevice parent_obj;
+
+    MemoryRegion ctrl;
+    MemoryRegion area;
+
+    uint64_t area_size;
+    uint32_t guest_page_size;
+
+    uint32_t status;
+    uint64_t block_size;
+    uint64_t block_offset;
+    uint64_t ping_info_addr;
+    uint32_t handle;
+    uint32_t next_handle;
+
+    GasBlock *blocks;
+    uint32_t nblocks, capblocks;
+};
+
+static uint64_t gas_alloc(GasState *s, uint64_t size)
+{
+    /* 对齐到页 */
+    uint64_t ps = s->guest_page_size ?: 4096;
+    uint64_t aligned = ((size + ps - 1) / ps) * ps;
+
+    /* 找空闲可复用块（首次匹配足够） */
+    uint64_t cursor = 0;
+    for (uint32_t i = 0; i < s->nblocks; i++) {
+        if (!s->blocks[i].used && s->blocks[i].size == aligned) {
+            s->blocks[i].used = true;
+            return s->blocks[i].offset;
+        }
+    }
+    /* bump 到已用块之后 */
+    for (uint32_t i = 0; i < s->nblocks; i++) {
+        if (s->blocks[i].used &&
+            s->blocks[i].offset + s->blocks[i].size > cursor) {
+            cursor = s->blocks[i].offset + s->blocks[i].size;
+        }
+    }
+    if (cursor + aligned > s->area_size) {
+        error_report("gf-as: 空间耗尽 (need 0x%" PRIx64 ")", aligned);
+        return UINT64_MAX;
+    }
+    if (s->nblocks == s->capblocks) {
+        s->capblocks = s->capblocks ? s->capblocks * 2 : 32;
+        s->blocks = g_renew(GasBlock, s->blocks, s->capblocks);
+    }
+    s->blocks[s->nblocks] = (GasBlock){ cursor, aligned, true };
+    s->nblocks++;
+    return cursor;
+}
+
+static void gas_free(GasState *s, uint64_t offset)
+{
+    for (uint32_t i = 0; i < s->nblocks; i++) {
+        if (s->blocks[i].used && s->blocks[i].offset == offset) {
+            s->blocks[i].used = false;
+            return;
+        }
+    }
+}
+
+static uint64_t gas_bar1_addr(GasState *s)
+{
+    /* BAR1 的 guest 物理地址（由 PCI 总线分配后更新） */
+    return pci_get_bar_addr(&s->parent_obj, 1);
+}
+
+static void gas_cmd(GasState *s, uint32_t cmd)
+{
+    switch (cmd) {
+    case GAS_CMD_ALLOCATE_BLOCK: {
+        uint64_t off = gas_alloc(s, s->block_size);
+        if (off == UINT64_MAX) {
+            s->status = 12; /* ENOMEM */
+        } else {
+            s->block_offset = off;
+            s->status = 0;
+        }
+        break;
+    }
+    case GAS_CMD_DEALLOCATE_BLOCK:
+        gas_free(s, s->block_offset);
+        s->status = 0;
+        break;
+    case GAS_CMD_GEN_HANDLE:
+        s->handle = ++s->next_handle;
+        s->status = 0;
+        break;
+    case GAS_CMD_DESTROY_HANDLE:
+        s->handle = 0;
+        s->status = 0;
+        break;
+    case GAS_CMD_TELL_PING_INFO_ADDR:
+        s->status = 0;
+        break;
+    default:
+        s->status = 22; /* EINVAL */
+    }
+}
+
+static void gas_write(void *opaque, hwaddr off, uint64_t val, unsigned size)
+{
+    GasState *s = opaque;
+    if (GAS_DEBUG) {
+        error_report("gf-as: write reg 0x%" HWADDR_PRIX " = 0x%" PRIx64, off, val);
+    }
+    switch (off) {
+    case GAS_REG_COMMAND:
+        gas_cmd(s, (uint32_t)val);
+        break;
+    case GAS_REG_GUEST_PAGE_SIZE:
+        s->guest_page_size = (uint32_t)val;
+        break;
+    case GAS_REG_BLOCK_SIZE_LOW:
+        s->block_size = (s->block_size & ~0xFFFFFFFFULL) | val;
+        break;
+    case GAS_REG_BLOCK_SIZE_HIGH:
+        s->block_size = (s->block_size & 0xFFFFFFFFULL) | (val << 32);
+        break;
+    case GAS_REG_BLOCK_OFFSET_LOW:
+        s->block_offset = (s->block_offset & ~0xFFFFFFFFULL) | val;
+        break;
+    case GAS_REG_BLOCK_OFFSET_HIGH:
+        s->block_offset = (s->block_offset & 0xFFFFFFFFULL) | (val << 32);
+        break;
+    case GAS_REG_PING_INFO_ADDR_LOW:
+        s->ping_info_addr = (s->ping_info_addr & ~0xFFFFFFFFULL) | val;
+        break;
+    case GAS_REG_PING_INFO_ADDR_HIGH:
+        s->ping_info_addr = (s->ping_info_addr & 0xFFFFFFFFULL) | (val << 32);
+        break;
+    default:
+        break;
+    }
+}
+
+static uint64_t gas_read(void *opaque, hwaddr off, unsigned size)
+{
+    GasState *s = opaque;
+    switch (off) {
+    case GAS_REG_STATUS:
+        return s->status;
+    case GAS_REG_GUEST_PAGE_SIZE:
+        return s->guest_page_size;
+    case GAS_REG_BLOCK_SIZE_LOW:
+        return s->block_size & 0xFFFFFFFF;
+    case GAS_REG_BLOCK_SIZE_HIGH:
+        return s->block_size >> 32;
+    case GAS_REG_BLOCK_OFFSET_LOW:
+        return s->block_offset & 0xFFFFFFFF;
+    case GAS_REG_BLOCK_OFFSET_HIGH:
+        return s->block_offset >> 32;
+    case GAS_REG_HANDLE:
+        return s->handle;
+    case GAS_REG_PHYS_START_LOW: {
+        uint64_t a = gas_bar1_addr(s);
+        return a & 0xFFFFFFFF;
+    }
+    case GAS_REG_PHYS_START_HIGH: {
+        uint64_t a = gas_bar1_addr(s);
+        return a >> 32;
+    }
+    case GAS_REG_PING_INFO_ADDR_LOW:
+        return s->ping_info_addr & 0xFFFFFFFF;
+    case GAS_REG_PING_INFO_ADDR_HIGH:
+        return s->ping_info_addr >> 32;
+    default:
+        return 0;
+    }
+}
+
+static const MemoryRegionOps gas_ops = {
+    .read = gas_read,
+    .write = gas_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void gas_realize(PCIDevice *dev, Error **errp)
+{
+    GasState *s = GOLDFISH_ADDRESS_SPACE(dev);
+
+    if (s->area_size < 0x100000) {
+        error_setg(errp, "goldfish-address-space: area-size 最小 1MB");
+        return;
+    }
+
+    memory_region_init_io(&s->ctrl, OBJECT(s), &gas_ops, s,
+                          "gf-as.ctrl", 0x1000);
+    pci_register_bar(dev, 0, PCI_BASE_ADDRESS_SPACE_MEMORY, &s->ctrl);
+
+    memory_region_init_ram(&s->area, OBJECT(s), "gf-as.area",
+                           s->area_size, errp);
+    /* 64 位 + prefetchable：内核 memremap(MEMREMAP_WB) 要求可缓存 BAR */
+    pci_register_bar(dev, 1,
+                     PCI_BASE_ADDRESS_SPACE_MEMORY |
+                     PCI_BASE_ADDRESS_MEM_TYPE_64 |
+                     PCI_BASE_ADDRESS_MEM_PREFETCH, &s->area);
+
+    s->guest_page_size = 4096;
+    s->next_handle = 0;
+    pci_config_set_vendor_id(dev->config, GAS_VENDOR_ID);
+    pci_config_set_device_id(dev->config, GAS_DEVICE_ID);
+    dev->config[PCI_REVISION_ID] = 0x01; /* 内核 probe 要求 revision==1 */
+    pci_config_set_class(dev->config, PCI_CLASS_OTHERS);
+}
+
+static const Property gas_properties[] = {
+    DEFINE_PROP_UINT64("area-size", GasState, area_size, 128 * 1024 * 1024),
+};
+
+static void gas_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+    PCIDeviceClass *k = PCI_DEVICE_CLASS(oc);
+
+    k->realize = gas_realize;
+    k->vendor_id = GAS_VENDOR_ID;
+    k->device_id = GAS_DEVICE_ID;
+    k->class_id = PCI_CLASS_OTHERS;
+    dc->desc = "RanchuWoA goldfish address space (gralloc shared memory)";
+    device_class_set_props(dc, gas_properties);
+    set_bit(DEVICE_CATEGORY_MISC, dc->categories);
+}
+
+static const TypeInfo gas_info = {
+    .name = TYPE_GOLDFISH_ADDRESS_SPACE,
+    .parent = TYPE_PCI_DEVICE,
+    .instance_size = sizeof(GasState),
+    .class_init = gas_class_init,
+    .interfaces = (InterfaceInfo[]) {
+        { INTERFACE_CONVENTIONAL_PCI_DEVICE },
+        { },
+    },
+};
+
+static void gas_register(void)
+{
+    type_register_static(&gas_info);
+}
+
+type_init(gas_register);
--- a/hw/android/goldfish-battery.c
+++ b/hw/android/goldfish-battery.c
@@ -0,0 +1,138 @@
+/*
+ * goldfish-battery.c — RanchuWoA goldfish battery 设备
+ *
+ * 寄存器布局按内核 drivers/power/supply/goldfish_battery.c：
+ *   0x00 INT_STATUS(R)/INT_ENABLE(W)  0x08 AC_ONLINE   0x0c STATUS
+ *   0x10 HEALTH  0x14 PRESENT  0x18 CAPACITY  0x1c VOLTAGE_UV
+ *   0x20 TEMP    0x24 CHARGE_TYPE  0x28 CHARGING_SWITCH  0x30 CURRENT_UA
+ * 恒定上报：AC 在线、电池在位、电量 100、状态 FULL、健康 GOOD。
+ */
+
+#include "qemu/osdep.h"
+#include "hw/core/sysbus.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev.h"
+#include "system/address-spaces.h"
+#include "system/memory.h"
+#include "qemu/timer.h"
+#include "qom/object.h"
+
+#define TYPE_GOLDFISH_BATTERY "goldfish-battery"
+OBJECT_DECLARE_SIMPLE_TYPE(GoldfishBatteryState, GOLDFISH_BATTERY)
+
+enum {
+    REG_INT_STATUS = 0x00,
+    REG_INT_ENABLE = 0x04,
+    REG_AC_ONLINE = 0x08,
+    REG_STATUS = 0x0c,
+    REG_HEALTH = 0x10,
+    REG_PRESENT = 0x14,
+    REG_CAPACITY = 0x18,
+    REG_VOLTAGE = 0x1c,
+    REG_TEMP = 0x20,
+    REG_CHARGE_TYPE = 0x24,
+    REG_CHARGING_SWITCH = 0x28,
+    REG_CURRENT = 0x30,
+    REG_CYCLE_COUNT = 0x34,
+};
+
+/* POWER_SUPPLY_STATUS_* / HEALTH_* 内核枚举值 */
+#define BATT_STATUS_FULL   4
+#define BATT_HEALTH_GOOD   1
+
+struct GoldfishBatteryState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    uint32_t int_enable;
+};
+
+static uint64_t gf_batt_read(void *opaque, hwaddr offset, unsigned size)
+{
+    GoldfishBatteryState *s = opaque;
+    switch (offset) {
+    case REG_INT_STATUS:
+        /* 读清中断 */
+        qemu_set_irq(s->irq, 0);
+        return 0;
+    case REG_AC_ONLINE:
+        return 1;
+    case REG_STATUS:
+        return BATT_STATUS_FULL;
+    case REG_HEALTH:
+        return BATT_HEALTH_GOOD;
+    case REG_PRESENT:
+        return 1;
+    case REG_CAPACITY:
+        return 100;
+    case REG_VOLTAGE:
+        return 4350000;       /* µV */
+    case REG_TEMP:
+        return 250;           /* 0.1°C */
+    case REG_CHARGE_TYPE:
+        return 0;             /* N/A */
+    case REG_CHARGING_SWITCH:
+        return 0;
+    case REG_CURRENT:
+        return 0;             /* µA（未充电） */
+    case REG_CYCLE_COUNT:
+        return 0;
+    default:
+        return 0;
+    }
+}
+
+static void gf_batt_write(void *opaque, hwaddr offset, uint64_t value,
+                          unsigned size)
+{
+    GoldfishBatteryState *s = opaque;
+    if (offset == REG_INT_ENABLE) {
+        s->int_enable = value;
+    }
+}
+
+static const MemoryRegionOps gf_batt_ops = {
+    .read = gf_batt_read,
+    .write = gf_batt_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void gf_batt_realize(DeviceState *dev, Error **errp)
+{
+    GoldfishBatteryState *s = GOLDFISH_BATTERY(dev);
+    memory_region_init_io(&s->iomem, OBJECT(s), &gf_batt_ops, s,
+                          "goldfish.battery", 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(dev), &s->irq);
+}
+
+static void gf_batt_reset(DeviceState *dev)
+{
+    GoldfishBatteryState *s = GOLDFISH_BATTERY(dev);
+    s->int_enable = 0;
+    qemu_set_irq(s->irq, 0);
+}
+
+static void gf_batt_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+    dc->realize = gf_batt_realize;
+    device_class_set_legacy_reset(dc, gf_batt_reset);
+    dc->desc = "RanchuWoA goldfish battery device";
+    dc->user_creatable = false;
+}
+
+static const TypeInfo gf_batt_info = {
+    .name = TYPE_GOLDFISH_BATTERY,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(GoldfishBatteryState),
+    .class_init = gf_batt_class_init,
+};
+
+static void gf_batt_register(void)
+{
+    type_register_static(&gf_batt_info);
+}
+
+type_init(gf_batt_register);
--- a/hw/android/goldfish-pipe.c
+++ b/hw/android/goldfish-pipe.c
@@ -0,0 +1,990 @@
+/*
+ * goldfish-pipe.c — RanchuWoA 自研 goldfish pipe 设备（v2 协议）
+ *
+ * Android 模拟器 guest 与 host 之间的核心通信通道（adb/logcat 等全走它）。
+ * 按 android15-6.6 内核驱动 drivers/platform/goldfish/goldfish_pipe.c 的
+ * ABI 实现（内核只支持 v2，版本 < 2 直接 -EINVAL）。
+ *
+ * 寄存器（32-bit LE MMIO）:
+ *   W 0x00 CMD              — 写 pipe id 触发命令（读该 pipe 的命令缓冲）
+ *   W 0x04/0x08/0x0c SIGNAL_BUFFER(_HIGH/_COUNT) — 已唤醒管道共享缓冲
+ *   W 0x14/0x18 OPEN_BUFFER(_HIGH)               — open_command_param
+ *   RW 0x24 VERSION         — 驱动先写 2 再读，设备返回 2 并重置全部管道
+ *   R 0x30 GET_SIGNALLED    — 填充共享缓冲、返回条数、按需降 IRQ
+ *
+ * guest ABI 结构偏移（以内核源码为准，与旧规范文档不同）:
+ *   goldfish_pipe_command: cmd@0 id@4 status@8 reserved@12
+ *                          buffers_count@16 consumed_size@20
+ *                          ptrs@24 (336*8) sizes@24+2688 (336*4)
+ *   open_command_param:    command_buffer_ptr@0(u64) rw_params_max_count@8(u32)
+ *   signalled_pipe_buffer: id@0(u32) flags@4(u32)
+ */
+
+#include "qemu/osdep.h"
+#include "hw/core/sysbus.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev.h"
+#include "system/address-spaces.h"
+#include "system/memory.h"
+#include "qemu/log.h"
+#include "qemu/error-report.h"
+#include "qemu/sockets.h"
+#include "qemu/main-loop.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "qom/object.h"
+#include "ranchu-sensors.h"
+
+#ifdef _WIN32
+#define gf_sock_errno() WSAGetLastError()
+#else
+#define gf_sock_errno() errno
+#endif
+
+/* ---- guest ABI 常量（与内核 goldfish_pipe_qemu.h 一致） ---- */
+#define GF_PIPE_VERSION   2
+#define GF_MAX_BUFFERS    336
+
+enum {
+    GF_CMD_OPEN = 1, GF_CMD_CLOSE, GF_CMD_POLL, GF_CMD_WRITE,
+    GF_CMD_WAKE_ON_WRITE, GF_CMD_READ, GF_CMD_WAKE_ON_READ,
+    GF_CMD_WAKE_ON_DONE_IO,
+};
+
+#define GF_ERR_INVAL  (-1)
+#define GF_ERR_AGAIN  (-2)
+
+#define GF_POLL_IN    (1 << 0)
+#define GF_POLL_OUT   (1 << 1)
+#define GF_POLL_HUP   (1 << 2)
+
+#define GF_WAKE_CLOSED (1 << 0)
+#define GF_WAKE_READ   (1 << 1)
+#define GF_WAKE_WRITE  (1 << 2)
+
+/* goldfish_pipe_command 字段偏移 */
+#define CMD_OFF_CMD       0
+#define CMD_OFF_STATUS    8
+#define CMD_OFF_CNT      16
+#define CMD_OFF_CONSUMED 20
+#define CMD_OFF_PTRS     24
+#define CMD_OFF_SIZES    (CMD_OFF_PTRS + GF_MAX_BUFFERS * 8)
+
+#define GF_RING_SIZE  (256 * 1024)
+#define GF_NAME_MAX   160
+
+#define TYPE_GOLDFISH_PIPE "goldfish-pipe"
+OBJECT_DECLARE_SIMPLE_TYPE(GoldfishPipeState, GOLDFISH_PIPE)
+
+typedef struct GfPipe GfPipe;
+typedef struct GfPipeSvc GfPipeSvc;
+
+typedef struct {            /* host->guest 输出环形缓冲 */
+    uint8_t *buf;
+    size_t head, tail, cap;
+} GfRing;
+
+struct GfPipe {
+    uint32_t id;
+    uint64_t cmd_buf;            /* guest 物理地址：goldfish_pipe_command */
+    bool closed;
+    bool armed_read;
+    char name[GF_NAME_MAX];
+    size_t name_len;
+    const GfPipeSvc *svc;
+    void *priv;
+    GfRing out;
+    bool out_full;
+    uint8_t wanted;
+    QTAILQ_ENTRY(GfPipe) wanted_entry;
+};
+
+struct GoldfishPipeState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+
+    uint64_t signalled_buf_addr;
+    uint32_t signalled_count;
+    uint64_t open_cmd_addr;
+
+    GfPipe **pipes;
+    uint32_t pipes_capacity;
+
+    QTAILQ_HEAD(, GfPipe) wanted_list;
+    bool irq_raised;
+};
+
+/* ------------------------------------------------------------------ */
+/* 环形缓冲                                                            */
+/* ------------------------------------------------------------------ */
+
+static size_t gf_ring_used(const GfRing *r) { return r->head - r->tail; }
+static size_t gf_ring_free(const GfRing *r) { return r->cap - gf_ring_used(r); }
+
+static void gf_ring_put(GfRing *r, const uint8_t *data, size_t len)
+{
+    g_assert(gf_ring_free(r) >= len);
+    for (size_t i = 0; i < len; i++) {
+        r->buf[r->head++ % r->cap] = data[i];
+    }
+    if (r->tail >= r->cap) {
+        r->head -= r->cap;
+        r->tail -= r->cap;
+    }
+}
+
+static size_t gf_ring_take(GfRing *r, uint8_t *dst, size_t len)
+{
+    size_t n = MIN(len, gf_ring_used(r));
+    for (size_t i = 0; i < n; i++) {
+        dst[i] = r->buf[r->tail++ % r->cap];
+    }
+    return n;
+}
+
+/* ------------------------------------------------------------------ */
+/* guest 内存辅助                                                      */
+/* ------------------------------------------------------------------ */
+
+static uint32_t gf_read_le32(uint64_t addr)
+{
+    uint8_t b[4];
+    address_space_read(&address_space_memory, addr,
+                       MEMTXATTRS_UNSPECIFIED, b, 4);
+    return ldl_le_p(b);
+}
+
+static uint64_t gf_read_le64(uint64_t addr)
+{
+    uint8_t b[8];
+    address_space_read(&address_space_memory, addr,
+                       MEMTXATTRS_UNSPECIFIED, b, 8);
+    return ldq_le_p(b);
+}
+
+static void gf_write_le32(uint64_t addr, uint32_t v)
+{
+    uint8_t b[4];
+    stl_le_p(b, v);
+    address_space_write(&address_space_memory, addr,
+                        MEMTXATTRS_UNSPECIFIED, b, 4);
+}
+
+/* ------------------------------------------------------------------ */
+/* 唤醒                                                                */
+/* ------------------------------------------------------------------ */
+
+static void gf_pipe_want(GoldfishPipeState *s, GfPipe *p, uint8_t flags)
+{
+    if (!flags || p->closed) {
+        return;
+    }
+    if (p->wanted == 0) {
+        QTAILQ_INSERT_TAIL(&s->wanted_list, p, wanted_entry);
+    }
+    p->wanted |= flags;
+    if (!s->irq_raised) {
+        s->irq_raised = true;
+        qemu_set_irq(s->irq, 1);
+    }
+}
+
+static void gf_pipe_data_arrived(GoldfishPipeState *s, GfPipe *p)
+{
+    if (p->armed_read && gf_ring_used(&p->out) > 0) {
+        p->armed_read = false;
+        gf_pipe_want(s, p, GF_WAKE_READ);
+    }
+}
+
+static void gf_pipe_closed_by_host(GoldfishPipeState *s, GfPipe *p)
+{
+    if (p->closed) {
+        return;
+    }
+    p->closed = true;
+    gf_pipe_want(s, p, GF_WAKE_CLOSED);
+}
+
+/* ------------------------------------------------------------------ */
+/* 服务框架                                                            */
+/* ------------------------------------------------------------------ */
+
+struct GfPipeSvc {
+    const char *prefix;
+    int (*connect)(GoldfishPipeState *s, GfPipe *p, const char *name);
+    void (*recv)(GoldfishPipeState *s, GfPipe *p,
+                 const uint8_t *data, size_t len);
+    void (*drained)(GoldfishPipeState *s, GfPipe *p);
+    void (*close)(GoldfishPipeState *s, GfPipe *p);
+};
+
+static void gf_send_to_guest(GoldfishPipeState *s, GfPipe *p,
+                             const uint8_t *data, size_t len)
+{
+    size_t free_ = gf_ring_free(&p->out);
+    size_t n = MIN(len, free_);
+    gf_ring_put(&p->out, data, n);
+    if (n < len) {
+        p->out_full = true;
+    }
+    gf_pipe_data_arrived(s, p);
+}
+
+static void gf_maybe_drained(GoldfishPipeState *s, GfPipe *p)
+{
+    if (p->out_full && gf_ring_free(&p->out) > GF_RING_SIZE / 2) {
+        p->out_full = false;
+        if (p->svc && p->svc->drained) {
+            p->svc->drained(s, p);
+        }
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* logcat 服务                                                         */
+/* ------------------------------------------------------------------ */
+
+static int gf_logcat_connect(GoldfishPipeState *s, GfPipe *p,
+                             const char *name)
+{
+    return 0;
+}
+
+static void gf_logcat_recv(GoldfishPipeState *s, GfPipe *p,
+                           const uint8_t *data, size_t len)
+{
+    static GMutex lock;
+    g_mutex_lock(&lock);
+    fwrite(data, 1, len, stderr);
+    g_mutex_unlock(&lock);
+}
+
+static const GfPipeSvc gf_svc_logcat = {
+    .prefix = "logcat",
+    .connect = gf_logcat_connect,
+    .recv = gf_logcat_recv,
+};
+
+/* ------------------------------------------------------------------ */
+/* adb 桥接                                                            */
+/* ------------------------------------------------------------------ */
+
+/*
+ * guest 打开 "pipe:qemud:adb:5555" 后：
+ *   guest->"accept" ; adb server 连入 host:5555 后 host->"ok" ;
+ *   guest->"start" 进入字节透传。
+ * host 侧向 adb server(127.0.0.1:5037) 发 "0012host:emulator:5555" 注册。
+ */
+
+enum { GF_ADB_ST_WAIT_ACCEPT, GF_ADB_ST_WAIT_CONN, GF_ADB_ST_WAIT_START,
+       GF_ADB_ST_STREAMING };
+
+typedef struct GfAdbPipe {
+    int st;
+    int sock;                 /* 与 adb server 的连接 */
+    uint8_t *wr_pending;      /* guest->host 待发数据 */
+    size_t wr_len, wr_off;
+} GfAdbPipe;
+
+typedef struct GfAdbHost {
+    GoldfishPipeState *pipe_dev;
+    int listen_fd;            /* host:5555 监听 */
+    GfAdbPipe *early;         /* adb server 先于 guest 到达时暂存 */
+    GfPipe *early_pipe;       /* 暂存对应的 guest 管道（未 accept 前） */
+    int reg_fd;               /* 5037 注册连接 */
+    QEMUTimer *retry_timer;
+    bool reg_sent;
+} GfAdbHost;
+
+static GfAdbHost gf_adb_host = {
+    .listen_fd = -1,
+    .reg_fd = -1,
+};
+
+static void gf_adb_reg_retry_timer_cb(void *opaque);
+
+static void gf_adb_reg_schedule(GfAdbHost *h)
+{
+    if (!h->retry_timer) {
+        h->retry_timer = timer_new_ms(QEMU_CLOCK_REALTIME,
+                                      gf_adb_reg_retry_timer_cb, h);
+    }
+    timer_mod(h->retry_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 3000);
+}
+
+static void gf_adb_reg_connected(void *opaque);      /* writable 回调 */
+static void gf_adb_reg_readable(void *opaque);       /* readable 回调 */
+
+static void gf_adb_reg_start(GfAdbHost *h)
+{
+    struct sockaddr_in sa = {
+        .sin_family = AF_INET,
+        .sin_port = htons(5037),
+        .sin_addr.s_addr = htonl(INADDR_LOOPBACK),
+    };
+    int fd = qemu_socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0) {
+        gf_adb_reg_schedule(h);
+        return;
+    }
+    qemu_set_blocking(fd, false, NULL);
+    int r = connect(fd, (struct sockaddr *)&sa, sizeof(sa));
+    if (r < 0 && gf_sock_errno() != EWOULDBLOCK &&
+        gf_sock_errno() != EINPROGRESS) {
+        close(fd);
+        gf_adb_reg_schedule(h);
+        return;
+    }
+    h->reg_fd = fd;
+    h->reg_sent = false;
+    error_report("gf-adb: 正在连接 adb server(5037)...");
+    qemu_set_fd_handler(fd, NULL, gf_adb_reg_connected, h);
+}
+
+static void gf_adb_reg_retry_timer_cb(void *opaque)
+{
+    GfAdbHost *h = opaque;
+    if (h->reg_fd < 0) {
+        gf_adb_reg_start(h);
+    }
+}
+
+static void gf_adb_reg_connected(void *opaque)
+{
+    GfAdbHost *h = opaque;
+    static const char msg[] = "0012host:emulator:5555";
+    ssize_t r = send(h->reg_fd, msg, sizeof(msg) - 1, 0);
+    if (r < 0 && gf_sock_errno() == EWOULDBLOCK) {
+        return;   /* 继续等 writable */
+    }
+    h->reg_sent = true;
+    /* 等 adb server 应答后关闭；它随后会连 5555 */
+    qemu_set_fd_handler(h->reg_fd, gf_adb_reg_readable, NULL, h);
+}
+
+static void gf_adb_reg_readable(void *opaque)
+{
+    GfAdbHost *h = opaque;
+    char buf[64];
+    ssize_t r = recv(h->reg_fd, buf, sizeof(buf), 0);
+    if (r > 0) {
+        return;   /* 继续读到对端关闭或静默 */
+    }
+    qemu_set_fd_handler(h->reg_fd, NULL, NULL, NULL);
+    close(h->reg_fd);
+    h->reg_fd = -1;
+    if (!h->reg_sent) {
+        gf_adb_reg_schedule(h);
+        return;
+    }
+    error_report("gf-adb: registered with adb server (emulator:5555)");
+}
+
+static void gf_adb_sock_readable(void *opaque);
+static void gf_adb_sock_writable(void *opaque);
+
+/* adb server 连入 5555 */
+static void gf_adb_listen_cb(void *opaque)
+{
+    GfAdbHost *h = &gf_adb_host;
+    struct sockaddr_in sa;
+    socklen_t slen = sizeof(sa);
+    int fd = accept(h->listen_fd, (struct sockaddr *)&sa, &slen);
+    if (fd < 0) {
+        return;
+    }
+    qemu_set_blocking(fd, false, NULL);
+    error_report("gf-adb: adb server 连入 5555");
+
+    GfAdbPipe *a = g_new0(GfAdbPipe, 1);
+    a->st = GF_ADB_ST_WAIT_CONN;
+    a->sock = fd;
+    if (h->early_pipe && h->early) {
+        /* guest 已 accept 等连接：换绑 */
+        close(h->early->sock);
+        g_free(h->early->wr_pending);
+        g_free(h->early);
+        h->early = a;
+        gf_send_to_guest(h->pipe_dev, h->early_pipe,
+                         (const uint8_t *)"ok", 2);
+        h->early->st = GF_ADB_ST_WAIT_START;
+    } else {
+        h->early = a;   /* 等 guest 的 accept */
+    }
+}
+
+static void gf_adb_host_init(GoldfishPipeState *s)
+{
+    GfAdbHost *h = &gf_adb_host;
+    h->pipe_dev = s;
+    if (h->listen_fd >= 0) {
+        return;
+    }
+    struct sockaddr_in sa = {
+        .sin_family = AF_INET,
+        .sin_port = htons(5555),
+        .sin_addr.s_addr = htonl(INADDR_LOOPBACK),
+    };
+    int fd = qemu_socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0 || bind(fd, (struct sockaddr *)&sa, sizeof(sa)) < 0 ||
+        listen(fd, 4) < 0) {
+        error_report("gf-adb: 5555 监听失败: %s", strerror(gf_sock_errno()));
+        if (fd >= 0) {
+            close(fd);
+        }
+        return;
+    }
+    qemu_set_blocking(fd, false, NULL);
+    h->listen_fd = fd;
+    qemu_set_fd_handler(fd, gf_adb_listen_cb, NULL, h);
+    gf_adb_reg_start(h);
+}
+
+static GfPipe *gf_adb_pipe_of(void *opaque)   /* opaque 即 GfPipe* */
+{
+    return opaque;
+}
+
+static void gf_adb_sock_readable(void *opaque)
+{
+    GfPipe *p = gf_adb_pipe_of(opaque);
+    GoldfishPipeState *s = gf_adb_host.pipe_dev;
+    GfAdbPipe *a = p->priv;
+    uint8_t tmp[65536];
+    ssize_t r = recv(a->sock, tmp, sizeof(tmp), 0);
+    if (r > 0) {
+        gf_send_to_guest(s, p, tmp, r);
+    } else if (r == 0 || gf_sock_errno() != EWOULDBLOCK) {
+        qemu_set_fd_handler(a->sock, NULL, NULL, NULL);
+        close(a->sock);
+        a->sock = -1;
+        gf_pipe_closed_by_host(s, p);
+    }
+}
+
+static void gf_adb_sock_writable(void *opaque)
+{
+    GfPipe *p = gf_adb_pipe_of(opaque);
+    GoldfishPipeState *s = gf_adb_host.pipe_dev;
+    GfAdbPipe *a = p->priv;
+    while (a->wr_len > a->wr_off) {
+        ssize_t r = send(a->sock, a->wr_pending + a->wr_off,
+                         a->wr_len - a->wr_off, 0);
+        if (r > 0) {
+            a->wr_off += r;
+        } else if (r < 0 && gf_sock_errno() == EWOULDBLOCK) {
+            return;
+        } else {
+            qemu_set_fd_handler(a->sock, NULL, NULL, NULL);
+            close(a->sock);
+            a->sock = -1;
+            gf_pipe_closed_by_host(s, p);
+            return;
+        }
+    }
+    a->wr_len = a->wr_off = 0;
+    qemu_set_fd_handler(a->sock, gf_adb_sock_readable, NULL, p);
+}
+
+static int gf_adb_connect(GoldfishPipeState *s, GfPipe *p, const char *name)
+{
+    gf_adb_host_init(s);
+    GfAdbPipe *a = g_new0(GfAdbPipe, 1);
+    a->st = GF_ADB_ST_WAIT_ACCEPT;
+    a->sock = -1;
+    p->priv = a;
+    return 0;
+}
+
+static void gf_adb_recv(GoldfishPipeState *s, GfPipe *p,
+                        const uint8_t *data, size_t len)
+{
+    GfAdbHost *h = &gf_adb_host;
+    GfAdbPipe *a = p->priv;
+
+    switch (a->st) {
+    case GF_ADB_ST_WAIT_ACCEPT:
+        if (len >= 6 && !memcmp(data, "accept", 6)) {
+            a->st = GF_ADB_ST_WAIT_CONN;
+            if (h->early && h->early->st == GF_ADB_ST_WAIT_CONN) {
+                /* adb server 已连入：接管其 socket */
+                g_free(a->wr_pending);
+                g_free(a);
+                p->priv = a = h->early;
+                gf_send_to_guest(s, p, (const uint8_t *)"ok", 2);
+                a->st = GF_ADB_ST_WAIT_START;
+            } else {
+                h->early = a;
+                h->early_pipe = p;   /* 等 listen 回调发 ok */
+            }
+        } else {
+            gf_pipe_closed_by_host(s, p);
+        }
+        break;
+    case GF_ADB_ST_WAIT_START:
+        if (len >= 5 && !memcmp(data, "start", 5)) {
+            a->st = GF_ADB_ST_STREAMING;
+            qemu_set_fd_handler(a->sock, gf_adb_sock_readable, NULL, p);
+            error_report("gf-adb: adb 透传已建立");
+        }
+        break;
+    case GF_ADB_ST_STREAMING: {
+        if (a->sock < 0) {
+            return;
+        }
+        size_t off = 0;
+        if (a->wr_len == a->wr_off) {
+            ssize_t r = send(a->sock, data, len, 0);
+            if (r > 0) {
+                off = r;
+            } else if (r < 0 && gf_sock_errno() != EWOULDBLOCK) {
+                qemu_set_fd_handler(a->sock, NULL, NULL, NULL);
+                close(a->sock);
+                a->sock = -1;
+                gf_pipe_closed_by_host(s, p);
+                return;
+            }
+        }
+        if (off < len) {
+            size_t pend = a->wr_len - a->wr_off;
+            a->wr_pending = g_realloc(a->wr_pending, pend + len - off);
+            memmove(a->wr_pending, a->wr_pending + a->wr_off, pend);
+            memcpy(a->wr_pending + pend, data + off, len - off);
+            a->wr_len = pend + len - off;
+            a->wr_off = 0;
+            qemu_set_fd_handler(a->sock, gf_adb_sock_readable,
+                                gf_adb_sock_writable, p);
+        }
+        break;
+    }
+    default:
+        break;
+    }
+    if (h->early == a && a->st == GF_ADB_ST_STREAMING) {
+        h->early_pipe = NULL;
+    }
+}
+
+static void gf_adb_drained(GoldfishPipeState *s, GfPipe *p)
+{
+    GfAdbPipe *a = p->priv;
+    if (a->st == GF_ADB_ST_STREAMING && a->sock >= 0 &&
+        a->wr_len == a->wr_off) {
+        qemu_set_fd_handler(a->sock, gf_adb_sock_readable, NULL, p);
+    }
+}
+
+static void gf_adb_close(GoldfishPipeState *s, GfPipe *p)
+{
+    GfAdbHost *h = &gf_adb_host;
+    GfAdbPipe *a = p->priv;
+    if (a->sock >= 0) {
+        qemu_set_fd_handler(a->sock, NULL, NULL, NULL);
+        close(a->sock);
+        a->sock = -1;
+    }
+    if (h->early == a) {
+        h->early = NULL;
+        h->early_pipe = NULL;
+    }
+    g_free(a->wr_pending);
+    g_free(a);
+    p->priv = NULL;
+}
+
+static const GfPipeSvc gf_svc_adb = {
+    .prefix = "pipe:qemud:adb:",
+    .connect = gf_adb_connect,
+    .recv = gf_adb_recv,
+    .drained = gf_adb_drained,
+    .close = gf_adb_close,
+};
+
+/* ------------------------------------------------------------------ */
+/* qemud:sensors（协议实现在 ranchu-sensors.c，与 vsock 传输共用）      */
+/* ------------------------------------------------------------------ */
+
+typedef struct GfSensorsPipe {
+    GoldfishPipeState *s;
+    GfPipe *p;
+    RanchuSensors *rs;
+} GfSensorsPipe;
+
+static void gf_sensors_send(void *opaque, const uint8_t *data, size_t len)
+{
+    GfSensorsPipe *g = opaque;
+    gf_send_to_guest(g->s, g->p, data, len);
+}
+
+static int gf_sensors_connect(GoldfishPipeState *s, GfPipe *p,
+                              const char *name)
+{
+    GfSensorsPipe *g = g_new0(GfSensorsPipe, 1);
+    g->s = s;
+    g->p = p;
+    g->rs = ranchu_sensors_new(gf_sensors_send, g);
+    p->priv = g;
+    return 0;
+}
+
+static void gf_sensors_recv(GoldfishPipeState *s, GfPipe *p,
+                            const uint8_t *data, size_t len)
+{
+    GfSensorsPipe *g = p->priv;
+    ranchu_sensors_recv(g->rs, data, len);
+}
+
+static void gf_sensors_close(GoldfishPipeState *s, GfPipe *p)
+{
+    GfSensorsPipe *g = p->priv;
+    if (g) {
+        ranchu_sensors_free(g->rs);
+        g_free(g);
+        p->priv = NULL;
+    }
+}
+
+static const GfPipeSvc gf_svc_sensors = {
+    .prefix = "pipe:qemud:sensors",
+    .connect = gf_sensors_connect,
+    .recv = gf_sensors_recv,
+    .close = gf_sensors_close,
+};
+
+/* ------------------------------------------------------------------ */
+/* 服务分派与命令处理                                                   */
+/* ------------------------------------------------------------------ */
+
+static const GfPipeSvc *gf_svcs[] = { &gf_svc_adb, &gf_svc_logcat, &gf_svc_sensors };
+
+static void gf_pipe_connect_service(GoldfishPipeState *s, GfPipe *p)
+{
+    error_report("gf-pipe: 管道 %u 请求服务: \"%s\"", p->id, p->name);
+    for (size_t i = 0; i < ARRAY_SIZE(gf_svcs); i++) {
+        if (g_str_has_prefix(p->name, gf_svcs[i]->prefix)) {
+            p->svc = gf_svcs[i];
+            if (gf_svcs[i]->connect(s, p, p->name) == 0) {
+                return;
+            }
+            p->svc = NULL;
+            break;
+        }
+    }
+    qemu_log_mask(LOG_UNIMP,
+                  "gf-pipe: 未知服务 \"%s\"，关闭管道\n", p->name);
+    gf_pipe_closed_by_host(s, p);
+}
+
+static void gf_pipe_free(GoldfishPipeState *s, GfPipe *p)
+{
+    if (p->svc && p->svc->close) {
+        p->svc->close(s, p);
+    }
+    if (p->wanted) {
+        QTAILQ_REMOVE(&s->wanted_list, p, wanted_entry);
+    }
+    if (gf_adb_host.early_pipe == p) {
+        gf_adb_host.early_pipe = NULL;
+        gf_adb_host.early = NULL;
+    }
+    g_free(p->out.buf);
+    g_free(p);
+}
+
+static void gf_cmd_write(GoldfishPipeState *s, GfPipe *p)
+{
+    uint64_t cmdbuf = p->cmd_buf;
+    uint32_t cnt = gf_read_le32(cmdbuf + CMD_OFF_CNT);
+    if (cnt == 0 || cnt > GF_MAX_BUFFERS) {
+        gf_write_le32(cmdbuf + CMD_OFF_STATUS, GF_ERR_INVAL);
+        return;
+    }
+    uint64_t total_bytes = 0, copied = 0;
+    for (uint32_t i = 0; i < cnt; i++) {
+        total_bytes += gf_read_le32(cmdbuf + CMD_OFF_SIZES + i * 4);
+    }
+
+    size_t dlen = MIN(total_bytes, (uint64_t)GF_RING_SIZE);
+    uint8_t *data = g_malloc(dlen);
+    for (uint32_t i = 0; i < cnt && copied < dlen; i++) {
+        uint64_t ptr = gf_read_le64(cmdbuf + CMD_OFF_PTRS + i * 8);
+        uint32_t sz = gf_read_le32(cmdbuf + CMD_OFF_SIZES + i * 4);
+        size_t want = MIN((size_t)sz, dlen - copied);
+        address_space_read(&address_space_memory, ptr,
+                           MEMTXATTRS_UNSPECIFIED, data + copied, want);
+        copied += want;
+    }
+
+    if (!p->svc && p->name_len == 0) {
+        size_t n = MIN(dlen, GF_NAME_MAX - 1);
+        memcpy(p->name, data, n);
+        p->name[n] = 0;
+        p->name_len = n;
+        gf_pipe_connect_service(s, p);
+    } else if (p->svc && p->svc->recv) {
+        p->svc->recv(s, p, data, dlen);
+    }
+    g_free(data);
+    gf_write_le32(cmdbuf + CMD_OFF_CONSUMED, (int32_t)total_bytes);
+    gf_write_le32(cmdbuf + CMD_OFF_STATUS, (int32_t)total_bytes);
+}
+
+static void gf_cmd_read(GoldfishPipeState *s, GfPipe *p)
+{
+    uint64_t cmdbuf = p->cmd_buf;
+    uint32_t cnt = gf_read_le32(cmdbuf + CMD_OFF_CNT);
+    if (cnt == 0 || cnt > GF_MAX_BUFFERS) {
+        gf_write_le32(cmdbuf + CMD_OFF_STATUS, GF_ERR_INVAL);
+        return;
+    }
+    size_t got = 0;
+    uint8_t tmp[8192];
+    for (uint32_t i = 0; i < cnt && gf_ring_used(&p->out) > 0; i++) {
+        uint64_t ptr = gf_read_le64(cmdbuf + CMD_OFF_PTRS + i * 8);
+        uint32_t sz = gf_read_le32(cmdbuf + CMD_OFF_SIZES + i * 4);
+        size_t done = 0;
+        while (done < sz && gf_ring_used(&p->out) > 0) {
+            size_t chunk = MIN(sz - done, sizeof(tmp));
+            chunk = gf_ring_take(&p->out, tmp, chunk);
+            address_space_write(&address_space_memory, ptr + done,
+                                MEMTXATTRS_UNSPECIFIED, tmp, chunk);
+            done += chunk;
+        }
+        got += done;
+    }
+    if (got == 0) {
+        if (p->closed) {
+            gf_write_le32(cmdbuf + CMD_OFF_CONSUMED, 0);
+            gf_write_le32(cmdbuf + CMD_OFF_STATUS, 0);    /* EOF */
+        } else {
+            gf_write_le32(cmdbuf + CMD_OFF_STATUS, GF_ERR_AGAIN);
+        }
+        return;
+    }
+    gf_write_le32(cmdbuf + CMD_OFF_CONSUMED, (int32_t)got);
+    gf_write_le32(cmdbuf + CMD_OFF_STATUS, (int32_t)got);
+    gf_maybe_drained(s, p);
+}
+
+static void gf_pipe_reset_all(GoldfishPipeState *s)
+{
+    for (uint32_t i = 0; i < s->pipes_capacity; i++) {
+        if (s->pipes[i]) {
+            gf_pipe_free(s, s->pipes[i]);
+            s->pipes[i] = NULL;
+        }
+    }
+    QTAILQ_INIT(&s->wanted_list);
+    qemu_set_irq(s->irq, 0);
+    s->irq_raised = false;
+}
+
+static void gf_do_open(GoldfishPipeState *s, uint32_t id)
+{
+    /* open_cmd_addr -> open_command_param{command_buffer_ptr, max_cnt} */
+    uint64_t cmd_ptr = gf_read_le64(s->open_cmd_addr);
+    uint32_t cmd = gf_read_le32(cmd_ptr + CMD_OFF_CMD);
+    if (cmd != GF_CMD_OPEN) {
+        return;
+    }
+    GfPipe *p = g_new0(GfPipe, 1);
+    p->id = id;
+    p->cmd_buf = cmd_ptr;
+    p->out.buf = g_malloc(GF_RING_SIZE);
+    p->out.cap = GF_RING_SIZE;
+    if (id >= s->pipes_capacity) {
+        uint32_t newcap = MAX(s->pipes_capacity * 2, id + 1);
+        s->pipes = g_renew(GfPipe *, s->pipes, newcap);
+        memset(s->pipes + s->pipes_capacity, 0,
+               (newcap - s->pipes_capacity) * sizeof(void *));
+        s->pipes_capacity = newcap;
+    }
+    s->pipes[id] = p;
+    gf_write_le32(cmd_ptr + CMD_OFF_STATUS, 0);
+}
+
+static void gf_do_command(GoldfishPipeState *s, GfPipe *p)
+{
+    uint64_t cmdbuf = p->cmd_buf;
+    uint32_t cmd = gf_read_le32(cmdbuf + CMD_OFF_CMD);
+
+    switch (cmd) {
+    case GF_CMD_CLOSE:
+        gf_write_le32(cmdbuf + CMD_OFF_STATUS, 0);
+        s->pipes[p->id] = NULL;
+        gf_pipe_free(s, p);
+        break;
+    case GF_CMD_POLL: {
+        uint32_t st = GF_POLL_OUT;
+        if (gf_ring_used(&p->out) > 0 || p->closed) {
+            st |= GF_POLL_IN;
+        }
+        if (p->closed) {
+            st |= GF_POLL_HUP;
+        }
+        gf_write_le32(cmdbuf + CMD_OFF_STATUS, st);
+        break;
+    }
+    case GF_CMD_WRITE:
+        if (p->closed) {
+            gf_write_le32(cmdbuf + CMD_OFF_STATUS, GF_ERR_INVAL);
+        } else {
+            gf_cmd_write(s, p);
+        }
+        break;
+    case GF_CMD_READ:
+        gf_cmd_read(s, p);
+        break;
+    case GF_CMD_WAKE_ON_READ:
+        p->armed_read = true;
+        if (gf_ring_used(&p->out) > 0) {
+            p->armed_read = false;
+            gf_pipe_want(s, p, GF_WAKE_READ);
+        }
+        gf_write_le32(cmdbuf + CMD_OFF_STATUS, 0);
+        break;
+    case GF_CMD_WAKE_ON_WRITE:
+    case GF_CMD_WAKE_ON_DONE_IO:
+        gf_write_le32(cmdbuf + CMD_OFF_STATUS, 0);
+        break;
+    default:
+        gf_write_le32(cmdbuf + CMD_OFF_STATUS, GF_ERR_INVAL);
+        break;
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* MMIO                                                                */
+/* ------------------------------------------------------------------ */
+
+static void gf_pipe_write(void *opaque, hwaddr offset, uint64_t value,
+                          unsigned size)
+{
+    GoldfishPipeState *s = opaque;
+    switch (offset) {
+    case 0: {   /* PIPE_REG_CMD：value = pipe id */
+        if (value < s->pipes_capacity && s->pipes[value]) {
+            gf_do_command(s, s->pipes[value]);
+        } else {
+            gf_do_open(s, (uint32_t)value);
+        }
+        break;
+    }
+    case 4:
+        s->signalled_buf_addr = (uint64_t)value << 32;
+        break;
+    case 8:
+        s->signalled_buf_addr |= value;
+        break;
+    case 12:
+        s->signalled_count = value;
+        break;
+    case 20:
+        s->open_cmd_addr = (uint64_t)value << 32;
+        break;
+    case 24:
+        s->open_cmd_addr |= value;
+        break;
+    case 36:    /* VERSION 写：驱动版本 */
+        break;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "gf-pipe: 未知写寄存器 0x%" HWADDR_PRIX "\n", offset);
+        break;
+    }
+}
+
+static uint64_t gf_pipe_read(void *opaque, hwaddr offset, unsigned size)
+{
+    GoldfishPipeState *s = opaque;
+    switch (offset) {
+    case 36:    /* VERSION 读：重置并返回 2 */
+        gf_pipe_reset_all(s);
+        return GF_PIPE_VERSION;
+    case 48: {  /* GET_SIGNALLED */
+        if (!s->signalled_buf_addr || !s->signalled_count) {
+            return 0;
+        }
+        uint32_t n = 0;
+        GfPipe *p;
+        while (n < s->signalled_count &&
+               (p = QTAILQ_FIRST(&s->wanted_list)) != NULL) {
+            QTAILQ_REMOVE(&s->wanted_list, p, wanted_entry);
+            uint8_t entry[8];
+            stl_le_p(entry, p->id);
+            stl_le_p(entry + 4, p->wanted);
+            address_space_write(&address_space_memory,
+                                s->signalled_buf_addr + (uint64_t)n * 8,
+                                MEMTXATTRS_UNSPECIFIED, entry, 8);
+            p->wanted = 0;
+            n++;
+        }
+        if (QTAILQ_EMPTY(&s->wanted_list)) {
+            qemu_set_irq(s->irq, 0);
+            s->irq_raised = false;
+        }
+        return n;
+    }
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "gf-pipe: 未知读寄存器 0x%" HWADDR_PRIX "\n", offset);
+        return 0;
+    }
+}
+
+static const MemoryRegionOps gf_pipe_ops = {
+    .read = gf_pipe_read,
+    .write = gf_pipe_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+/* ------------------------------------------------------------------ */
+/* 设备生命周期                                                        */
+/* ------------------------------------------------------------------ */
+
+static void gf_pipe_reset(DeviceState *dev)
+{
+    GoldfishPipeState *s = GOLDFISH_PIPE(dev);
+    gf_pipe_reset_all(s);
+    s->signalled_buf_addr = 0;
+    s->signalled_count = 0;
+    s->open_cmd_addr = 0;
+}
+
+static void gf_pipe_realize(DeviceState *dev, Error **errp)
+{
+    GoldfishPipeState *s = GOLDFISH_PIPE(dev);
+    memory_region_init_io(&s->iomem, OBJECT(s), &gf_pipe_ops, s,
+                          "goldfish.pipe", 0x2000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(dev), &s->irq);
+    QTAILQ_INIT(&s->wanted_list);
+}
+
+static void gf_pipe_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+    dc->realize = gf_pipe_realize;
+    device_class_set_legacy_reset(dc, gf_pipe_reset);
+    dc->desc = "RanchuWoA goldfish pipe device (protocol v2)";
+    dc->user_creatable = false;
+    set_bit(DEVICE_CATEGORY_MISC, dc->categories);
+}
+
+static const TypeInfo gf_pipe_info = {
+    .name = TYPE_GOLDFISH_PIPE,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(GoldfishPipeState),
+    .class_init = gf_pipe_class_init,
+};
+
+static void gf_pipe_register(void)
+{
+    type_register_static(&gf_pipe_info);
+}
+
+type_init(gf_pipe_register);
--- a/hw/android/goldfish-sync.c
+++ b/hw/android/goldfish-sync.c
@@ -0,0 +1,171 @@
+/*
+ * goldfish-sync.c — RanchuWoA goldfish sync 设备（fence/timeline）
+ *
+ * 平台设备 @0xa020000 IRQ SPI 81（地址/中断在 hw/arm/virt.c 里分配）, compatible "google,goldfish-sync"。
+ * 协议与内核驱动 goldfish_drivers/goldfish_sync.c 对齐：
+ *   guest 写 GUESTCOMMAND_ADDR + 触发 BATCH_GUESTCOMMAND ->
+ *   设备从 guest 内存读 guestcmd{host_command, glsync_handle,
+ *   thread_handle, guest_timeline_handle}。
+ * 无 gfxstream 渲染器时 timeline/fence 命令为轻量记账实现。
+ */
+
+#include "qemu/osdep.h"
+#include "hw/core/sysbus.h"
+#include "hw/core/irq.h"
+#include "qemu/error-report.h"
+#include "system/address-spaces.h"
+#include "qemu/log.h"
+#include "qom/object.h"
+
+#define GS_DEBUG 0      /* 1：把寄存器写入打到 stderr */
+
+enum {
+    SYNC_REG_BATCH_COMMAND = 0x00,
+    SYNC_REG_BATCH_GUESTCOMMAND = 0x04,
+    SYNC_REG_BATCH_COMMAND_ADDR = 0x08,
+    SYNC_REG_BATCH_COMMAND_ADDR_HIGH = 0x0C,
+    SYNC_REG_BATCH_GUESTCOMMAND_ADDR = 0x10,
+    SYNC_REG_BATCH_GUESTCOMMAND_ADDR_HIGH = 0x14,
+    SYNC_REG_INIT = 0x18,
+};
+
+/* host_command 枚举 */
+enum {
+    CMD_SYNC_READY = 0,
+    CMD_CREATE_SYNC_TIMELINE = 1,
+    CMD_CREATE_SYNC_FENCE = 2,
+    CMD_SYNC_TIMELINE_INC = 3,
+    CMD_DESTROY_SYNC_TIMELINE = 4,
+    CMD_TRIGGER_HOST_WAIT = 5,
+};
+
+struct guestcmd {
+    uint64_t host_command;
+    uint64_t glsync_handle;
+    uint64_t thread_handle;
+    uint64_t guest_timeline_handle;
+};
+
+#define TYPE_GOLDFISH_SYNC "goldfish-sync"
+OBJECT_DECLARE_SIMPLE_TYPE(GoldfishSyncState, GOLDFISH_SYNC)
+
+struct GoldfishSyncState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+
+    uint64_t hostcmd_addr;      /* guest 批量命令缓冲 GPA */
+    uint64_t guestcmd_addr;
+    uint64_t next_timeline;
+    bool initialized;
+};
+
+static void gs_write(void *opaque, hwaddr off, uint64_t val, unsigned size)
+{
+    GoldfishSyncState *s = opaque;
+    if (GS_DEBUG) {
+        error_report("gf-sync: write reg 0x%" HWADDR_PRIX " = 0x%" PRIx64, off, val);
+    }
+    switch (off) {
+    case SYNC_REG_BATCH_GUESTCOMMAND_ADDR:
+        s->guestcmd_addr = (s->guestcmd_addr & ~0xFFFFFFFFULL) | val;
+        break;
+    case SYNC_REG_BATCH_GUESTCOMMAND_ADDR_HIGH:
+        s->guestcmd_addr = (s->guestcmd_addr & 0xFFFFFFFFULL) | (val << 32);
+        break;
+    case SYNC_REG_BATCH_COMMAND_ADDR:
+        s->hostcmd_addr = (s->hostcmd_addr & ~0xFFFFFFFFULL) | val;
+        break;
+    case SYNC_REG_BATCH_COMMAND_ADDR_HIGH:
+        s->hostcmd_addr = (s->hostcmd_addr & 0xFFFFFFFFULL) | (val << 32);
+        break;
+    case SYNC_REG_BATCH_GUESTCOMMAND: {
+        /* val=0 触发一批 guest 命令处理 */
+        struct guestcmd cmd;
+        if (s->guestcmd_addr == 0) {
+            break;
+        }
+        address_space_read(&address_space_memory, s->guestcmd_addr,
+                           MEMTXATTRS_UNSPECIFIED, &cmd, sizeof(cmd));
+        switch (cmd.host_command) {
+        case CMD_CREATE_SYNC_TIMELINE:
+        case CMD_SYNC_TIMELINE_INC:
+        case CMD_DESTROY_SYNC_TIMELINE:
+        case CMD_TRIGGER_HOST_WAIT:
+            /* 无渲染器：记账即可，guest 侧 sw_sync 自己管 fence */
+            qemu_log_mask(LOG_UNIMP,
+                          "gf-sync: cmd %llu tl=%llu (记账)\n",
+                          (unsigned long long)cmd.host_command,
+                          (unsigned long long)cmd.guest_timeline_handle);
+            break;
+        default:
+            break;
+        }
+        break;
+    }
+    case SYNC_REG_BATCH_COMMAND:
+        /* guest 处理完 host 命令后写 0 降 IRQ */
+        if (val == 0) {
+            qemu_set_irq(s->irq, 0);
+        }
+        break;
+    case SYNC_REG_INIT:
+        s->initialized = true;
+        qemu_log_mask(LOG_UNIMP, "gf-sync: 初始化完成\n");
+        break;
+    default:
+        break;
+    }
+}
+
+static uint64_t gs_read(void *opaque, hwaddr off, unsigned size)
+{
+    GoldfishSyncState *s = opaque;
+    switch (off) {
+    case SYNC_REG_BATCH_COMMAND:
+        /* 无 host 命令待处理 */
+        return 0;
+    case SYNC_REG_INIT:
+        return s->initialized ? 1 : 0;
+    default:
+        return 0;
+    }
+}
+
+static const MemoryRegionOps gs_ops = {
+    .read = gs_read,
+    .write = gs_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void gs_realize(DeviceState *dev, Error **errp)
+{
+    GoldfishSyncState *s = GOLDFISH_SYNC(dev);
+    memory_region_init_io(&s->iomem, OBJECT(s), &gs_ops, s,
+                          "goldfish.sync", 0x2000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(dev), &s->irq);
+}
+
+static void gs_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+    dc->realize = gs_realize;
+    dc->desc = "RanchuWoA goldfish sync device";
+    dc->user_creatable = false;
+}
+
+static const TypeInfo gs_info = {
+    .name = TYPE_GOLDFISH_SYNC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(GoldfishSyncState),
+    .class_init = gs_class_init,
+};
+
+static void gs_register(void)
+{
+    type_register_static(&gs_info);
+}
+
+type_init(gs_register);
--- a/hw/android/ranchu-sensors.c
+++ b/hw/android/ranchu-sensors.c
@@ -0,0 +1,185 @@
+/*
+ * RanchuWoA: qemud:sensors 服务 —— ranchu 多合一传感器 HAL 的宿主端。
+ *
+ * 协议（device/generic/goldfish/sensors，libqemud 帧格式："%04x" 十六进制长度 + 负载）：
+ *   guest->"list-sensors"        host->"<掩码>"（按 kQemuSensorName 的下标）
+ *   guest->"time:<ns>" / "set-delay:<ms>" / "set:<名字>:<0|1>"
+ *   host->"acceleration:x:y:z"、"magnetic:x:y:z"、"light:v" ……、"sync:<us>"
+ * HAL 构造时若打不开通道会直接 abort，而 system_server 会一直等 ISensors 服务，
+ * 所以没有这个服务 Android 起不来。这里报告一组静态读数：竖屏直立、静止、室内光照。
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/timer.h"
+#include "ranchu-sensors.h"
+
+enum {
+    RS_ACCEL = 0,
+    RS_GYRO = 1,
+    RS_MAGNETIC = 2,
+    RS_ORIENTATION = 3,
+    RS_TEMPERATURE = 4,
+    RS_PROXIMITY = 5,
+    RS_LIGHT = 6,
+    RS_PRESSURE = 7,
+    RS_HUMIDITY = 8,
+    RS_COUNT = 9,
+};
+
+static const char *const rs_names[RS_COUNT] = {
+    "acceleration", "gyroscope", "magnetic-field", "orientation", "temperature",
+    "proximity", "light", "pressure", "humidity",
+};
+
+struct RanchuSensors {
+    RanchuSensorsSendFn send;
+    void *opaque;
+    QEMUTimer *timer;
+    uint32_t enabled;       /* 按 rs_names 下标的位图 */
+    uint32_t delay_ms;
+    uint8_t in[512];        /* guest->host 帧重组 */
+    size_t in_len;
+};
+
+static void G_GNUC_PRINTF(2, 3) rs_send(RanchuSensors *s, const char *fmt, ...)
+{
+    char msg[128];
+    char frame[136];
+    va_list ap;
+
+    va_start(ap, fmt);
+    int len = vsnprintf(msg, sizeof(msg), fmt, ap);
+    va_end(ap);
+    if (len <= 0 || len >= (int)sizeof(msg)) {
+        return;
+    }
+    snprintf(frame, sizeof(frame), "%04x%s", len, msg);
+    s->send(s->opaque, (const uint8_t *)frame, 4 + len);
+}
+
+static void rs_arm(RanchuSensors *s)
+{
+    if (s->enabled) {
+        timer_mod(s->timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + s->delay_ms);
+    } else {
+        timer_del(s->timer);
+    }
+}
+
+static void rs_tick(void *opaque)
+{
+    RanchuSensors *s = opaque;
+    uint32_t e = s->enabled;
+
+    if (e & (1u << RS_ACCEL)) {
+        rs_send(s, "acceleration:0.0:9.80665:0.0");
+    }
+    if (e & (1u << RS_GYRO)) {
+        rs_send(s, "gyroscope:0.0:0.0:0.0");
+    }
+    if (e & (1u << RS_MAGNETIC)) {
+        rs_send(s, "magnetic:0.0:5.9:-48.4");
+    }
+    if (e & (1u << RS_ORIENTATION)) {
+        rs_send(s, "orientation:0.0:-90.0:0.0");
+    }
+    if (e & (1u << RS_TEMPERATURE)) {
+        rs_send(s, "temperature:25.0");
+    }
+    if (e & (1u << RS_PROXIMITY)) {
+        rs_send(s, "proximity:1.0");
+    }
+    if (e & (1u << RS_LIGHT)) {
+        rs_send(s, "light:300.0");
+    }
+    if (e & (1u << RS_PRESSURE)) {
+        rs_send(s, "pressure:1013.25");
+    }
+    if (e & (1u << RS_HUMIDITY)) {
+        rs_send(s, "humidity:40.0");
+    }
+    rs_send(s, "sync:%" PRId64, qemu_clock_get_us(QEMU_CLOCK_VIRTUAL));
+    rs_arm(s);
+}
+
+static void rs_command(RanchuSensors *s, const char *cmd)
+{
+    if (strcmp(cmd, "list-sensors") == 0) {
+        rs_send(s, "%u", (1u << RS_COUNT) - 1);
+    } else if (g_str_has_prefix(cmd, "set-delay:")) {
+        unsigned long v = strtoul(cmd + 10, NULL, 10);
+        s->delay_ms = MAX(10ul, MIN(v, 1000ul));
+        rs_arm(s);
+    } else if (g_str_has_prefix(cmd, "set:")) {
+        const char *name = cmd + 4;
+        const char *colon = strrchr(name, ':');
+        if (!colon) {
+            return;
+        }
+        for (int i = 0; i < RS_COUNT; i++) {
+            if (strlen(rs_names[i]) == (size_t)(colon - name) &&
+                strncmp(rs_names[i], name, colon - name) == 0) {
+                if (atoi(colon + 1)) {
+                    s->enabled |= 1u << i;
+                } else {
+                    s->enabled &= ~(1u << i);
+                }
+            }
+        }
+        rs_arm(s);
+    }
+    /* "time:<ns>" 等其余命令无需应答 */
+}
+
+RanchuSensors *ranchu_sensors_new(RanchuSensorsSendFn send, void *opaque)
+{
+    RanchuSensors *s = g_new0(RanchuSensors, 1);
+    s->send = send;
+    s->opaque = opaque;
+    s->delay_ms = 200;
+    s->timer = timer_new_ms(QEMU_CLOCK_VIRTUAL, rs_tick, s);
+    return s;
+}
+
+void ranchu_sensors_recv(RanchuSensors *s, const uint8_t *data, size_t len)
+{
+    while (len > 0) {
+        size_t n = MIN(len, sizeof(s->in) - s->in_len);
+        memcpy(s->in + s->in_len, data, n);
+        s->in_len += n;
+        data += n;
+        len -= n;
+        /* 逐帧消费 */
+        while (s->in_len >= 4) {
+            char hdr[5];
+            memcpy(hdr, s->in, 4);
+            hdr[4] = 0;
+            unsigned long flen = strtoul(hdr, NULL, 16);
+            if (flen >= sizeof(s->in) - 4) {
+                s->in_len = 0;          /* 帧坏了，丢弃 */
+                break;
+            }
+            if (s->in_len < 4 + flen) {
+                break;
+            }
+            char cmd[sizeof(s->in)];
+            memcpy(cmd, s->in + 4, flen);
+            cmd[flen] = 0;
+            memmove(s->in, s->in + 4 + flen, s->in_len - 4 - flen);
+            s->in_len -= 4 + flen;
+            rs_command(s, cmd);
+        }
+        if (s->in_len == sizeof(s->in)) {
+            s->in_len = 0;
+        }
+    }
+}
+
+void ranchu_sensors_free(RanchuSensors *s)
+{
+    if (s) {
+        timer_free(s->timer);
+        g_free(s);
+    }
+}
