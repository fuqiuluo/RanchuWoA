+MakeCurrentFn sRealMakeCurrent = nullptr;
+std::recursive_mutex sLock;
+// ANGLE 后端（StateManager11）最后一次按哪个 context 重置过；nullptr 表示未知，下次必重绑。
+EGLContext sLastContext = EGL_NO_CONTEXT;
+
+struct ThreadCurrent {
+    EGLDisplay dpy = EGL_NO_DISPLAY;
+    EGLSurface draw = EGL_NO_SURFACE;
+    EGLSurface read = EGL_NO_SURFACE;
+    EGLContext ctx = EGL_NO_CONTEXT;
+};
+thread_local ThreadCurrent tCurrent;
+
+std::unordered_set<void*>& thunks() {
+    static std::unordered_set<void*> s;
+    return s;
+}
+
+// 调用方已持锁。
+void ensureCurrentLocked() {
+    const ThreadCurrent& t = tCurrent;
+    if (t.ctx == EGL_NO_CONTEXT || t.ctx == sLastContext) return;
+    // 同一 context 的 eglMakeCurrent 会被 ANGLE 短路，先解绑才能触发 onMakeCurrent。
+    sRealMakeCurrent(t.dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    sRealMakeCurrent(t.dpy, t.draw, t.read, t.ctx);
+    sLastContext = t.ctx;
+}
+
+}  // namespace
+
+void enable(MakeCurrentFn realMakeCurrent) {
+    if (gfxstream::base::getEnvironmentVariable("GFXSTREAM_ANGLE_SERIALIZE") == "0") {
+        GFXSTREAM_INFO("ANGLE 调用串行化已关闭（GFXSTREAM_ANGLE_SERIALIZE=0）");
+        return;
+    }
+    sRealMakeCurrent = realMakeCurrent;
+    sEnabled = realMakeCurrent != nullptr;
+    GFXSTREAM_INFO("ANGLE 调用串行化：%s", sEnabled ? "开启" : "失败（缺 eglMakeCurrent）");
+}
+
+bool enabled() { return sEnabled; }
+
+bool isThunk(void* f) {
+    std::lock_guard<std::recursive_mutex> lock(sLock);
+    return thunks().count(f) != 0;
+}
+
+void registerThunk(void* f) {
+    std::lock_guard<std::recursive_mutex> lock(sLock);
+    thunks().insert(f);
+}
+
+Scope::Scope(bool checkContext) {
+    sLock.lock();
+    if (checkContext) ensureCurrentLocked();
+}
+
+Scope::~Scope() { sLock.unlock(); }
+
+EGLBoolean makeCurrent(EGLDisplay dpy, EGLSurface draw, EGLSurface read, EGLContext ctx) {
+    std::lock_guard<std::recursive_mutex> lock(sLock);
+    ThreadCurrent& t = tCurrent;
+    if (ctx != EGL_NO_CONTEXT && ctx == t.ctx && draw == t.draw && read == t.read &&
+        dpy == t.dpy) {
+        // ANGLE 会短路这次调用；只需保证后端状态属于本线程。
+        ensureCurrentLocked();
+        return EGL_TRUE;
+    }
+    EGLBoolean ok = sRealMakeCurrent(dpy, draw, read, ctx);
+    if (ok) {
+        t = ThreadCurrent{dpy, draw, read, ctx};
+        if (ctx != EGL_NO_CONTEXT) sLastContext = ctx;
+    }
+    return ok;
+}
+
+void onContextDestroyed() {
+    // ANGLE 销毁非 current 的 context 时会临时切过去再切回；后端此刻属于谁不好说，强制下次重绑。
+    std::lock_guard<std::recursive_mutex> lock(sLock);
+    sLastContext = EGL_NO_CONTEXT;
+}
+
+void onThreadReleased() {
+    std::lock_guard<std::recursive_mutex> lock(sLock);
+    tCurrent = ThreadCurrent{};
+}
+
+unsigned long long nowNs() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+}
+
+void backoff(int iteration) {
+    // GPU 栅栏一般几毫秒内就绪：先让出时间片，久等再睡。
+    if (iteration < 200) {
+        std::this_thread::yield();
+    } else {
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+}
+
+}  // namespace angle_lock
+}  // namespace gfxstream
diff --git a/host/gl/glestranslator/common/include/common/angle_lock.h b/host/gl/glestranslator/common/include/common/angle_lock.h
new file mode 100644
index 0000000..59abc3b
--- /dev/null
+++ b/host/gl/glestranslator/common/include/common/angle_lock.h
@@ -0,0 +1,109 @@
+// RanchuWoA：宿主 ANGLE 调用串行化。
+//
+// ANGLE 的 D3D11 后端里，StateManager11（连同 D3D11 immediate context）属于整个 EGLDisplay，
+// 所有 context 共用；它只在 eglMakeCurrent 时按新 context 重置缓存（onMakeCurrent 把
+// mFramebuffer11 等清成 nullptr，再由“全部脏位”重新同步）。而 gfxstream 每个 guest 连接一个
+// 渲染线程、各自 context 同时 current，ANGLE 默认只按 share group 加锁——别的线程一次
+// eglMakeCurrent 就会让本线程下一次绘制拿着空的 mFramebuffer11 崩溃（Framebuffer11::
+// markAttachmentsDirty 读 nullptr+8，RESEARCH §24.4），即便不崩也会画到别人的状态上。
+//
+// 这里在 gfxstream 侧复刻 ANGLE 的 ANGLE_FORCE_CONTEXT_CHECK_EVERY_CALL 编译选项：所有进入
+// ANGLE 的 EGL/GL 调用持同一把全局锁；GL 调用前若后端最后见到的 context 不是本线程的，先
+// 解绑再绑回本线程 context（ANGLE 对同一 context 的 eglMakeCurrent 直接短路，必须先解绑），
+// 让 ANGLE 重置共享状态并把本 context 的状态全部标脏。
+#pragma once
+
+#include <EGL/egl.h>
+
+namespace gfxstream {
+namespace angle_lock {
+
+using MakeCurrentFn = EGLBoolean (*)(EGLDisplay, EGLSurface, EGLSurface, EGLContext);
+
+// 由 EGL-on-EGL 后端在加载完宿主 libEGL 后调用（传入未包装的 eglMakeCurrent）。
+// 环境变量 GFXSTREAM_ANGLE_SERIALIZE=0 可关闭（调试用）。
+void enable(MakeCurrentFn realMakeCurrent);
+bool enabled();
+
+// 持全局锁的作用域；checkContext=true 时还保证 ANGLE 后端当前就是本线程的 context。
+class Scope {
+   public:
+    explicit Scope(bool checkContext);
+    ~Scope();
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+};
+
+// eglMakeCurrent / eglDestroyContext / eglReleaseThread 的串行化版本（维护线程与全局记录）。
+EGLBoolean makeCurrent(EGLDisplay dpy, EGLSurface draw, EGLSurface read, EGLContext ctx);
+void onContextDestroyed();
+void onThreadReleased();
+
+// 每个被包装的函数指针一份静态存储：N 由 __COUNTER__ 保证唯一。
+template <bool CheckContext, int N, typename F>
+struct Thunk;
+
+template <bool CheckContext, int N, typename R, typename... A>
+struct Thunk<CheckContext, N, R (*)(A...)> {
+    static inline R (*real)(A...) = nullptr;
+    static R call(A... a) {
+        Scope scope(CheckContext);
+        return real(a...);
+    }
+};
+
+// 已发出的 thunk 登记表：同一函数指针会被多个 dispatcher 实例、多个函数列表重复处理，
+// 已是 thunk 的不能再包一层（否则 real 可能互相指向，无限递归）。
+bool isThunk(void* f);
+void registerThunk(void* f);
+
+template <bool CheckContext, int N, typename F>
+F wrap(F f) {
+    using T = Thunk<CheckContext, N, F>;
+    if (!f || !enabled() || isThunk((void*)f)) return f;
+    T::real = f;
+    registerThunk((void*)&T::call);
+    return &T::call;
+}
+
+// 轮询辅助：单调时钟（纳秒）与第 n 次轮询后的退让。
+unsigned long long nowNs();
+void backoff(int iteration);
+
+// glClientWaitSync 的替身：零超时轮询，两次轮询之间放开全局锁，避免一个线程等 GPU 时
+// 卡住所有线程。
+template <typename F>
+struct WaitThunk;
+
+template <typename R, typename S, typename B, typename T>
+struct WaitThunk<R (*)(S, B, T)> {
+    static constexpr R kTimeoutExpired = 0x911B;  // GL_TIMEOUT_EXPIRED
+    static constexpr B kFlushBit = 0x1;           // GL_SYNC_FLUSH_COMMANDS_BIT
+    static inline R (*real)(S, B, T) = nullptr;
+    static R call(S sync, B flags, T timeout) {
+        const unsigned long long start = nowNs();
+        for (int i = 0;; i++) {
+            R r;
+            {
+                Scope scope(true);
+                r = real(sync, flags, 0);
+            }
+            if (r != kTimeoutExpired || timeout == 0) return r;
+            flags &= ~kFlushBit;  // 首次轮询已经 flush 过
+            if (nowNs() - start >= timeout) return r;
+            backoff(i);
+        }
+    }
+};
+
+template <typename F>
+F wrapClientWaitSync(F f) {
+    using T = WaitThunk<F>;
+    if (!f || !enabled() || isThunk((void*)f)) return f;
+    T::real = f;
+    registerThunk((void*)&T::call);
+    return &T::call;
+}
+
+}  // namespace angle_lock
+}  // namespace gfxstream
